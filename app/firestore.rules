        && hasValidAxisValue(m, 'aerobicEndurance')
        && hasValidAxisValue(m, 'thresholdPower')
        && hasValidAxisValue(m, 'vo2MaxPower')
        && hasValidAxisValue(m, 'repeatedSurges')
