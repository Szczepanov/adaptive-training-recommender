rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy recovery snapshot collection (disabled after migration)
    match /daily_recovery_snapshot/{date} {
      allow read, write: if false;
    }
    
    // Legacy flat check-in collection (disabled after migration)
    match /daily_subjective_checkin/{document=**} {
      allow read, write: if false;
    }
    
    // User-owned collections with explicit scoping
    
    // Daily subjective check-ins (user-owned)
    match /users/{userId}/daily_subjective_checkins/{date} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Goals (user-owned)
    match /users/{userId}/goals/{goalId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Constraints (user-owned)
    match /users/{userId}/constraints/{constraintId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Preferences (singleton, user-owned)
    match /users/{userId}/preferences/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Daily recovery snapshots (user-owned, read-only for client app, written by admin backend)
    match /users/{userId}/daily_recovery_snapshots/{date} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Normalized activities (user-owned, read-only for client app, written by admin backend)
    match /users/{userId}/activities/{activityId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Daily recommendations (user-owned): the client app both writes these (persisting
    // what the engine just computed for that day) and later patches the `adherence`
    // sub-field once the user answers the "did you follow this?" prompt -- unlike
    // recovery snapshots/activities, this isn't admin-backend-only.
    match /users/{userId}/daily_recommendations/{date} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
