rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasOwnedUserId(userId) {
      return isOwner(userId) && request.resource.data.userId == userId;
    }

    function keepsOwnership(userId) {
      return hasOwnedUserId(userId)
        && resource.data.userId == userId
        && request.resource.data.userId == resource.data.userId;
    }

    function isDateDocument(date) {
      return request.resource.data.date == date
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function hasValidGoalTaper() {
      return !('taper' in request.resource.data)
        || (request.resource.data.taper is map
          && request.resource.data.taper.keys().hasOnly(['startDate'])
          && request.resource.data.taper.startDate is string
          && request.resource.data.taper.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function hasValidAdherence(adherence) {
      return adherence is map
        && adherence.keys().hasOnly(['respondedAt', 'followed', 'actualModality', 'actualDurationMin', 'skipped', 'notes'])
        && adherence.keys().hasAll(['respondedAt', 'followed', 'actualModality', 'actualDurationMin', 'skipped', 'notes'])
        && (adherence.respondedAt == null || adherence.respondedAt is string)
        && (adherence.followed == null || adherence.followed is bool)
        && (adherence.actualModality == null || adherence.actualModality is string)
        && (adherence.actualDurationMin == null || (adherence.actualDurationMin is number && adherence.actualDurationMin >= 0))
        && adherence.skipped is bool
        && (adherence.notes == null || adherence.notes is string);
    }

    // Adherence is the only routine update that does not change decision evidence. Keep
    // it on a bounded fast path: revalidating a nested v3 audit and prescription can hit
    // Firestore's 1,000-expression limit before the immutability checks are evaluated.
    function isValidAdherenceOnlyUpdate(userId, date) {
      return isOwner(userId)
        && resource.data.userId == userId
        && resource.data.date == date
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.date == resource.data.date
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adherence'])
        && hasValidAdherence(request.resource.data.adherence);
    }

    function hasValidDose(dose) {
      return dose is map
        && dose.keys().hasOnly(['volume', 'intensity'])
        && dose.keys().hasAll(['volume', 'intensity'])
        && dose.volume is number && dose.volume >= 0 && dose.volume <= 1
        && dose.intensity is number && dose.intensity >= 0 && dose.intensity <= 1.2;
    }

    // Phase 9.7/D-SUBJAUDIT: compact, normalized subjective-drift provenance. Optional --
    // production callers still supply no `subjectiveDrift` at all while the live default
    // stays 'off' (see rules.ts/provenance.ts); this only validates the shape when present.
    function hasValidSubjectiveDriftAudit(drift) {
      return drift is map
        && drift.keys().hasOnly(['estimatorId', 'estimatorPolicyVersion', 'historyThroughDateExclusive', 'recentRecordedDays', 'longRecordedDays', 'contribution', 'perMetricContributions', 'decisionRelevant'])
        && drift.keys().hasAll(['estimatorId', 'estimatorPolicyVersion', 'historyThroughDateExclusive', 'recentRecordedDays', 'longRecordedDays', 'contribution', 'perMetricContributions', 'decisionRelevant'])
        && drift.estimatorId is string && drift.estimatorId.size() > 0
        && drift.estimatorPolicyVersion is string && drift.estimatorPolicyVersion.size() > 0
        && drift.historyThroughDateExclusive is string
        && drift.recentRecordedDays is int && drift.recentRecordedDays >= 0
        && drift.longRecordedDays is int && drift.longRecordedDays >= 0
        && drift.contribution is number && drift.contribution >= 0
        && drift.decisionRelevant is bool
        && drift.perMetricContributions is map
        && drift.perMetricContributions.keys().hasOnly(['readiness', 'sleepQuality', 'fatigue', 'soreness', 'mentalStress', 'motivation'])
        && drift.perMetricContributions.keys().hasAll(['readiness', 'sleepQuality', 'fatigue', 'soreness', 'mentalStress', 'motivation'])
        && drift.perMetricContributions.readiness is number && drift.perMetricContributions.readiness >= 0
        && drift.perMetricContributions.sleepQuality is number && drift.perMetricContributions.sleepQuality >= 0
        && drift.perMetricContributions.fatigue is number && drift.perMetricContributions.fatigue >= 0
        && drift.perMetricContributions.soreness is number && drift.perMetricContributions.soreness >= 0
        && drift.perMetricContributions.mentalStress is number && drift.perMetricContributions.mentalStress >= 0
        && drift.perMetricContributions.motivation is number && drift.perMetricContributions.motivation >= 0;
    }

    function hasValidRecommendationAudit(audit) {
      return audit is map
        && audit.keys().hasOnly(['policyVersion', 'evaluatedAt', 'decisionContextRevision', 'safetyStatus', 'history', 'envelope', 'plannedDose', 'executionDose', 'candidateScores', 'droppedContributorObjectives', 'externalPlan', 'authoredOccurrence', 'primarySession', 'additionalSessions', 'subjectiveDrift'])
        && audit.keys().hasAll(['policyVersion', 'evaluatedAt', 'decisionContextRevision', 'safetyStatus', 'history', 'envelope', 'candidateScores'])
        && audit.policyVersion is string
        && audit.evaluatedAt is string
        && audit.decisionContextRevision is string
        && audit.safetyStatus == 'complete'
        && audit.history is map
        && audit.history.keys().hasOnly(['completedEventCount', 'unmatchedEventCount', 'sourceStatuses'])
        && audit.history.keys().hasAll(['completedEventCount', 'unmatchedEventCount', 'sourceStatuses'])
        && audit.history.completedEventCount is int && audit.history.completedEventCount >= 0
        && audit.history.unmatchedEventCount is int && audit.history.unmatchedEventCount >= 0
        && audit.history.sourceStatuses is map
        && audit.history.sourceStatuses.keys().hasOnly(['activities', 'recommendations', 'manualTraining'])
        && audit.history.sourceStatuses.keys().hasAll(['activities', 'recommendations', 'manualTraining'])
        && audit.history.sourceStatuses.activities in ['AVAILABLE', 'MISSING', 'INVALID', 'UNAVAILABLE']
        && audit.history.sourceStatuses.recommendations in ['AVAILABLE', 'MISSING', 'INVALID', 'UNAVAILABLE']
        && audit.history.sourceStatuses.manualTraining in ['AVAILABLE', 'MISSING', 'INVALID', 'UNAVAILABLE']
        && audit.envelope is map
        && audit.envelope.keys().hasOnly(['safetyRestrictedModalityCount', 'planMaxAllowableTier'])
        && audit.envelope.keys().hasAll(['safetyRestrictedModalityCount', 'planMaxAllowableTier'])
        && audit.envelope.safetyRestrictedModalityCount is int && audit.envelope.safetyRestrictedModalityCount >= 0
        && audit.envelope.planMaxAllowableTier in ['Rest', 'Mobility', 'Easy', 'Moderate', 'Hard']
        && (!('plannedDose' in audit) || hasValidDose(audit.plannedDose))
        && (!('executionDose' in audit) || hasValidDose(audit.executionDose))
        && audit.candidateScores is list && audit.candidateScores.size() <= 64
        && (!('droppedContributorObjectives' in audit) || (audit.droppedContributorObjectives is list && audit.droppedContributorObjectives.size() <= 64))
        && (!('primarySession' in audit) || hasValidSessionReferenceBinding(audit.primarySession))
        && (!('additionalSessions' in audit) || hasValidAdditionalSessions(audit.additionalSessions))
        && (!('externalPlan' in audit) || (
          audit.externalPlan is map
          && audit.externalPlan.keys().hasOnly(['planId', 'revision', 'sessionId', 'contentHash'])
          && audit.externalPlan.keys().hasAll(['planId', 'revision', 'sessionId', 'contentHash'])
          && audit.externalPlan.planId is string && audit.externalPlan.planId.size() <= 64
          && audit.externalPlan.revision is int && audit.externalPlan.revision >= 1
          && audit.externalPlan.sessionId is string && audit.externalPlan.sessionId.size() <= 64
          && audit.externalPlan.contentHash is string && audit.externalPlan.contentHash.size() <= 128
        ))
        && (!('authoredOccurrence' in audit) || (
          audit.authoredOccurrence is map
          && audit.authoredOccurrence.keys().hasOnly(['occurrenceId', 'decision'])
          && audit.authoredOccurrence.keys().hasAll(['occurrenceId', 'decision'])
          && audit.authoredOccurrence.occurrenceId is string && audit.authoredOccurrence.occurrenceId.size() <= 128
          && audit.authoredOccurrence.decision in ['proceed', 'scale']
        ))
        && (!('subjectiveDrift' in audit) || hasValidSubjectiveDriftAudit(audit.subjectiveDrift));
    }

    function hasValidRecommendation(userId, date) {
      return hasOwnedUserId(userId)
        && isDateDocument(date)
        && request.resource.data.keys().hasOnly(['userId', 'date', 'templateId', 'templateTitle', 'category', 'modality', 'mode', 'engineVerdict', 'rationale', 'schemaVersion', 'createdAt', 'updatedAt', 'adjustment', 'prescription', 'primarySession', 'additionalSessions', 'adherence', 'recommendationAudit', 'revision'])
        && request.resource.data.keys().hasAll(['userId', 'date', 'templateId', 'templateTitle', 'category', 'modality', 'mode', 'rationale', 'schemaVersion', 'createdAt', 'updatedAt', 'adherence'])
        && request.resource.data.templateId is string
        && request.resource.data.templateTitle is string
        && request.resource.data.category is string
        && request.resource.data.modality is string
        && request.resource.data.mode in ['train', 'modify', 'recover']
        && (!('engineVerdict' in request.resource.data) || request.resource.data.engineVerdict in ['proceed', 'scale', 'defer', 'skip', 'advisory'])
        && request.resource.data.rationale is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.schemaVersion in [1, 2, 3]
        && (!('revision' in request.resource.data) || (request.resource.data.revision is int && request.resource.data.revision >= 1))
        && hasValidAdherence(request.resource.data.adherence)
        && (!('primarySession' in request.resource.data) || hasValidSessionReferenceBinding(request.resource.data.primarySession))
        && (!('additionalSessions' in request.resource.data) || hasValidAdditionalSessions(request.resource.data.additionalSessions))
        && (request.resource.data.schemaVersion != 3
          || ('recommendationAudit' in request.resource.data && hasValidRecommendationAudit(request.resource.data.recommendationAudit)));
    }

    function schemaRatchets() {
      return request.resource.data.schemaVersion >= resource.data.schemaVersion;
    }

    // Takes the already-computed decisionChanged flag rather than calling
    // decisionFieldsUnchanged() itself -- see canUpdateRecommendation()'s comment for why.
    function auditWriteOnce(decisionChanged) {
      return !('recommendationAudit' in resource.data)
        || decisionChanged
        || (('recommendationAudit' in request.resource.data)
          && request.resource.data.recommendationAudit.policyVersion == resource.data.recommendationAudit.policyVersion
          && request.resource.data.recommendationAudit.evaluatedAt == resource.data.recommendationAudit.evaluatedAt);
    }

    function decisionFieldsUnchanged() {
      return request.resource.data.templateId == resource.data.templateId
        && request.resource.data.templateTitle == resource.data.templateTitle
        && request.resource.data.category == resource.data.category
        && request.resource.data.modality == resource.data.modality
        && request.resource.data.mode == resource.data.mode
        && (!('engineVerdict' in resource.data)
          || (('engineVerdict' in request.resource.data) && request.resource.data.engineVerdict == resource.data.engineVerdict))
        && request.resource.data.rationale == resource.data.rationale
        && (('prescription' in request.resource.data) == ('prescription' in resource.data))
        && (!('prescription' in resource.data)
          || (!('id' in resource.data.prescription) || request.resource.data.prescription.id == resource.data.prescription.id))
        && (('primarySession' in request.resource.data) == ('primarySession' in resource.data))
        && (!('primarySession' in resource.data) || request.resource.data.primarySession == resource.data.primarySession)
        && (('additionalSessions' in request.resource.data) == ('additionalSessions' in resource.data))
        && (!('additionalSessions' in resource.data) || request.resource.data.additionalSessions == resource.data.additionalSessions);
    }

    function archivesPriorRevision(userId, date) {
      let priorRevNum = ('revision' in resource.data) ? resource.data.revision : 1;
      let priorPath = /databases/$(database)/documents/users/$(userId)/daily_recommendations/$(date)/revisions/$(string(priorRevNum));
      let prior = getAfter(priorPath).data;
      return prior.revision == priorRevNum
        && prior.templateId == resource.data.templateId
        && prior.templateTitle == resource.data.templateTitle
        && prior.category == resource.data.category
        && prior.modality == resource.data.modality
        && prior.mode == resource.data.mode
        && prior.rationale == resource.data.rationale
        && (!('engineVerdict' in resource.data) || (('engineVerdict' in prior) && prior.engineVerdict == resource.data.engineVerdict))
        && (!('prescription' in resource.data) || (('prescription' in prior) && (!('id' in resource.data.prescription) || prior.prescription.id == resource.data.prescription.id)))
        && (('primarySession' in prior) == ('primarySession' in resource.data))
        && (!('primarySession' in resource.data) || prior.primarySession == resource.data.primarySession)
        && (('additionalSessions' in prior) == ('additionalSessions' in resource.data))
        && (!('additionalSessions' in resource.data) || prior.additionalSessions == resource.data.additionalSessions)
        && (!('recommendationAudit' in resource.data) || (('recommendationAudit' in prior) && prior.recommendationAudit.policyVersion == resource.data.recommendationAudit.policyVersion && prior.recommendationAudit.evaluatedAt == resource.data.recommendationAudit.evaluatedAt));
    }

    // decisionFieldsUnchanged() itself does ~10 field comparisons; the update rule below
    // used to call it 3 times over (once directly in each side of the changed/unchanged
    // branch, once more indirectly inside auditWriteOnce()) purely because the rules
    // language has no memoization. That redundancy was consuming enough of Firestore's
    // ~1000 expression-evaluation budget that a decision-changing update carrying a
    // populated additionalSessions binding could no longer be validated at all -- calling
    // it once via `let` and threading the result through recovers that headroom.
    function canUpdateRecommendation(userId, date) {
      let decisionChanged = !decisionFieldsUnchanged();
      return hasValidRecommendation(userId, date)
        && keepsOwnership(userId)
        && request.resource.data.createdAt == resource.data.createdAt
        && schemaRatchets()
        && auditWriteOnce(decisionChanged)
        && (
          (!decisionChanged && (
            (('revision' in resource.data) && request.resource.data.revision == resource.data.revision) ||
            (!('revision' in resource.data) && (!('revision' in request.resource.data) || request.resource.data.revision == 1))
          ))
          ||
          (decisionChanged && (
            request.resource.data.revision == (('revision' in resource.data) ? resource.data.revision : 1) + 1
            && archivesPriorRevision(userId, date)
          ))
        );
    }

    function hasValidHealthSymptoms(symptoms) {
      return symptoms is map
        && symptoms.keys().hasOnly(['present', 'onset', 'severity', 'types'])
        && symptoms.keys().hasAll(['present'])
        && symptoms.present is bool
        && (!('onset' in symptoms)
          || (symptoms.present && (symptoms.onset == null || symptoms.onset in ['today', 'yesterday', '2_3_days', 'earlier']))
          || (!symptoms.present && symptoms.onset == null))
        && (!('severity' in symptoms)
          || (symptoms.present && (symptoms.severity == null || symptoms.severity in ['mild', 'moderate', 'severe']))
          || (!symptoms.present && symptoms.severity == null))
        && (!('types' in symptoms)
          || (symptoms.present && (symptoms.types == null || (
            symptoms.types is list
            && symptoms.types.size() <= 8
            && symptoms.types.hasOnly(['sore_throat', 'congestion', 'cough', 'fever_or_chills', 'headache_or_body_aches', 'gastrointestinal', 'unusual_fatigue', 'other'])
          )))
          || (!symptoms.present && symptoms.types == null));
    }

    function hasValidHealthContext(context) {
      return context is map
        && context.keys().hasOnly(['alcoholDrinksLast24h', 'travelDisruption', 'timezoneShiftHours', 'unusualHeatOrSauna', 'dehydrationOrFluidLoss', 'recentVaccination', 'medicationChange', 'closeSickContact', 'otherDisruption', 'symptoms'])
        && (!('alcoholDrinksLast24h' in context) || (context.alcoholDrinksLast24h is int && context.alcoholDrinksLast24h >= 0 && context.alcoholDrinksLast24h <= 3))
        && (!('travelDisruption' in context) || context.travelDisruption in ['none', 'local_or_no_timezone', 'timezone_shift', 'late_arrival_or_disrupted_sleep'])
        && (!('timezoneShiftHours' in context) || context.timezoneShiftHours == null || (context.timezoneShiftHours is number && context.timezoneShiftHours >= -14 && context.timezoneShiftHours <= 14))
        && (!('unusualHeatOrSauna' in context) || context.unusualHeatOrSauna == null || context.unusualHeatOrSauna is bool)
        && (!('dehydrationOrFluidLoss' in context) || context.dehydrationOrFluidLoss == null || context.dehydrationOrFluidLoss is bool)
        && (!('recentVaccination' in context) || context.recentVaccination == null || context.recentVaccination is bool)
        && (!('medicationChange' in context) || context.medicationChange == null || context.medicationChange is bool)
        && (!('closeSickContact' in context) || context.closeSickContact == null || context.closeSickContact is bool)
        && (!('otherDisruption' in context) || context.otherDisruption == null || (context.otherDisruption is string && context.otherDisruption.size() <= 500))
        && (!('symptoms' in context) || hasValidHealthSymptoms(context.symptoms));
    }

    function hasValidSubjectiveHealthFields(data) {
      return (!('illnessSymptoms' in data) || data.illnessSymptoms is bool)
        && (!('healthContext' in data) || hasValidHealthContext(data.healthContext));
    }

    match /daily_recovery_snapshot/{date} { allow read, write: if false; }
    match /daily_subjective_checkin/{document=**} { allow read, write: if false; }

    match /users/{userId}/daily_subjective_checkins/{date} {
      allow read: if isOwner(userId);
      allow create: if hasOwnedUserId(userId) && isDateDocument(date) && hasValidSubjectiveHealthFields(request.resource.data);
      allow update: if keepsOwnership(userId) && isDateDocument(date) && request.resource.data.createdAt == resource.data.createdAt
        && hasValidSubjectiveHealthFields(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // --- Decision journal (Phase 9.0): immutable morning evidence plus an evening actual outcome.
    function hasValidDecisionJournalEntry(userId, date) {
      return hasOwnedUserId(userId)
        && isDateDocument(date)
        && request.resource.data.keys().hasOnly(['userId', 'date', 'externalVerdict', 'externalNote', 'sawEngineVerdictFirst', 'actualVerdict', 'createdAt', 'updatedAt', 'schemaVersion'])
        && request.resource.data.keys().hasAll(['userId', 'date', 'externalVerdict', 'sawEngineVerdictFirst', 'createdAt', 'updatedAt', 'schemaVersion'])
        && request.resource.data.externalVerdict in ['proceed', 'scale', 'defer', 'skip', 'advisory']
        && (!('externalNote' in request.resource.data) || (request.resource.data.externalNote is string && request.resource.data.externalNote.size() <= 2000))
        && request.resource.data.sawEngineVerdictFirst is bool
        && (!('actualVerdict' in request.resource.data) || request.resource.data.actualVerdict in ['proceed', 'scale', 'defer', 'skip', 'advisory'])
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.schemaVersion == 1;
    }

    match /users/{userId}/decision_journal/{date} {
      allow read: if isOwner(userId);
      allow create: if hasValidDecisionJournalEntry(userId, date);
      allow update: if keepsOwnership(userId)
        && hasValidDecisionJournalEntry(userId, date)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.sawEngineVerdictFirst == resource.data.sawEngineVerdictFirst
        && request.resource.data.externalVerdict == resource.data.externalVerdict
        && (('externalNote' in request.resource.data) == ('externalNote' in resource.data))
        && (!('externalNote' in resource.data) || request.resource.data.externalNote == resource.data.externalNote);
      allow delete: if false;
    }

    match /users/{userId}/goals/{goalId} {
      allow read: if isOwner(userId);
      allow create: if hasOwnedUserId(userId) && hasValidGoalTaper();
      allow update: if keepsOwnership(userId) && request.resource.data.createdAt == resource.data.createdAt && hasValidGoalTaper();
      allow delete: if isOwner(userId);
    }

    function isValidActivityDate(date) {
      return date is string && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && isRealCalendarDate(date.split('-'));
    }

    function isRealCalendarDate(parts) {
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let isLeapYear = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
      let daysInMonth = month == 2 ? (isLeapYear ? 29 : 28)
        : (month == 4 || month == 6 || month == 9 || month == 11) ? 30
        : 31;
      return month >= 1 && month <= 12 && day >= 1 && day <= daysInMonth;
    }

    function hasValidAxisValue(m, key) {
      return !(key in m) || (m[key] is number && m[key] >= 0 && m[key] <= 1);
    }

    function hasValidExpectedStimulus(m) {
      return m is map
        && m.keys().hasOnly(['aerobicEndurance', 'thresholdPower', 'vo2MaxPower', 'repeatedSurges', 'sprintPower', 'fatigueResistance', 'maxStrength', 'hypertrophy'])
        && m.size() <= 8
        && hasValidAxisValue(m, 'aerobicEndurance')
        && hasValidAxisValue(m, 'thresholdPower')
        && hasValidAxisValue(m, 'vo2MaxPower')
        && hasValidAxisValue(m, 'repeatedSurges')
        && hasValidAxisValue(m, 'sprintPower')
        && hasValidAxisValue(m, 'fatigueResistance')
        && hasValidAxisValue(m, 'maxStrength')
        && hasValidAxisValue(m, 'hypertrophy');
    }

    function hasValidExpectedCost(m) {
      return m is map
        && m.keys().hasOnly(['systemic', 'cardiovascular', 'lowerBody', 'upperBody', 'impactTissue', 'neuromuscular'])
        && m.size() <= 6
        && hasValidAxisValue(m, 'systemic')
        && hasValidAxisValue(m, 'cardiovascular')
        && hasValidAxisValue(m, 'lowerBody')
        && hasValidAxisValue(m, 'upperBody')
        && hasValidAxisValue(m, 'impactTissue')
        && hasValidAxisValue(m, 'neuromuscular');
    }

    function hasValidEquipmentList(list) {
      return list is list && list.size() <= 20;
    }

    function hasValidAvailabilityContextOverride(m) {
      return m is map
        && m.keys().hasOnly(['environment', 'equipment'])
        && (!('environment' in m) || m.environment in ['indoor', 'outdoor', 'either'])
        && (!('equipment' in m) || hasValidEquipmentList(m.equipment));
    }

    function hasValidOptionalCatalogId(data, key) {
      return !(key in data) || (data[key] is string && data[key].size() > 0 && data[key].size() <= 120);
    }

    function hasValidFixedActivity(userId) {
      let data = request.resource.data;
      return hasOwnedUserId(userId)
        && isValidActivityDate(data.date)
        && data.keys().hasOnly(['userId', 'title', 'date', 'startTime', 'durationMin', 'fixed', 'expectedStimulus', 'expectedCost', 'environment', 'equipment', 'availabilityOverride', 'availabilityContextOverride', 'templateId', 'workoutId', 'isCompleted', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['userId', 'title', 'date', 'durationMin', 'fixed', 'environment', 'isCompleted', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() <= 200
        && data.durationMin is int && data.durationMin > 0 && data.durationMin <= 1440
        && data.fixed is bool
        && data.environment in ['indoor', 'outdoor', 'either']
        && data.isCompleted is bool
        && data.createdAt is string
        && data.updatedAt is string
        && (!('startTime' in data) || data.startTime is string)
        && (!('expectedStimulus' in data) || hasValidExpectedStimulus(data.expectedStimulus))
        && (!('expectedCost' in data) || hasValidExpectedCost(data.expectedCost))
        && (!('equipment' in data) || hasValidEquipmentList(data.equipment))
        && (!('availabilityOverride' in data) || (data.availabilityOverride is number && data.availabilityOverride >= 0 && data.availabilityOverride <= 1440))
        && (!('availabilityContextOverride' in data) || hasValidAvailabilityContextOverride(data.availabilityContextOverride))
        && hasValidOptionalCatalogId(data, 'templateId')
        && hasValidOptionalCatalogId(data, 'workoutId');
    }

    match /users/{userId}/fixed_activities/{activityId} {
      allow read: if isOwner(userId);
      allow create: if hasValidFixedActivity(userId);
      allow update: if hasValidFixedActivity(userId)
        && keepsOwnership(userId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
    }

    function hasValidPlanBlock(userId) {
      let data = request.resource.data;
      return hasOwnedUserId(userId)
        && data.keys().hasOnly(['userId', 'eventId', 'phase', 'startDate', 'endDate', 'volumeScale', 'intensityScale', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['userId', 'phase', 'startDate', 'endDate', 'volumeScale', 'intensityScale', 'createdAt', 'updatedAt'])
        && data.phase == 'travel'
        && isValidActivityDate(data.startDate)
        && isValidActivityDate(data.endDate)
        && data.startDate <= data.endDate
        && data.volumeScale is number && data.volumeScale >= 0 && data.volumeScale <= 1
        && data.intensityScale is number && data.intensityScale >= 0 && data.intensityScale <= 1
        && (!('eventId' in data) || data.eventId is string)
        && data.createdAt is string && data.updatedAt is string;
    }

    function hasValidExternalPlanHeader(userId) {
      let data = request.resource.data;
      return hasOwnedUserId(userId)
        && data.keys().hasOnly(['userId', 'planId', 'revision', 'title', 'startDate', 'weekCount', 'contentHash', 'importedAt', 'supersededFrom', 'updatedAt'])
        && data.keys().hasAll(['userId', 'planId', 'revision', 'title', 'startDate', 'weekCount', 'contentHash', 'importedAt', 'updatedAt'])
        && data.planId is string && data.planId.size() > 0 && data.planId.size() <= 64
        && data.revision is int && data.revision >= 1
        && data.title is string && data.title.size() <= 200
        && isValidActivityDate(data.startDate)
        && data.weekCount is int && data.weekCount >= 1 && data.weekCount <= 26
        && data.contentHash is string && data.contentHash.size() == 64
        && data.importedAt is string && data.updatedAt is string
        && (!('supersededFrom' in data) || data.supersededFrom == null || isValidActivityDate(data.supersededFrom));
    }

    function hasValidExternalPlanRevision() {
      let data = request.resource.data;
      return data.keys().hasOnly(['schema', 'planId', 'revision', 'title', 'startDate', 'weekCount', 'notes', 'sessions'])
        && data.keys().hasAll(['schema', 'planId', 'revision', 'title', 'startDate', 'weekCount', 'sessions'])
        // M3.6: v2 carries the same envelope, just a normalized SessionDefinition per
        // session instead of v1's flat prescription -- neither is deep-validated here (see
        // the strength-session-logging comment below for why), so accepting either schema
        // literal changes nothing else about this check.
        && data.schema in ['adaptive-training-recommender/external-plan@1', 'adaptive-training-recommender/external-plan@2']
        && data.revision is int && data.revision >= 1
        && isValidActivityDate(data.startDate)
        && data.weekCount is int && data.weekCount >= 1 && data.weekCount <= 26
        && data.sessions is list && data.sessions.size() >= 1 && data.sessions.size() <= 120;
    }

    function hasValidExternalPlanPlacement(userId) {
      let data = request.resource.data;
      return hasOwnedUserId(userId)
        && data.keys().hasOnly(['userId', 'planId', 'revision', 'assignments', 'updatedAt'])
        && data.keys().hasAll(['userId', 'planId', 'revision', 'assignments', 'updatedAt'])
        && data.planId is string && data.planId.size() > 0 && data.planId.size() <= 64
        && data.revision is int && data.revision >= 1
        && data.assignments is list && data.assignments.size() <= 120
        && data.updatedAt is string;
    }

    match /users/{userId}/external_plans/{planId} {
      allow read: if isOwner(userId);
      allow create: if hasValidExternalPlanHeader(userId);
      allow update: if hasValidExternalPlanHeader(userId)
        && keepsOwnership(userId)
        && request.resource.data.planId == resource.data.planId
        && request.resource.data.revision >= resource.data.revision;
      allow delete: if isOwner(userId);

      match /revisions/{revisionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasValidExternalPlanRevision()
          && request.resource.data.planId == planId
          && string(request.resource.data.revision) == revisionId;
        allow update, delete: if false;
      }

      match /placement/{placementId} {
        allow read: if isOwner(userId);
        allow create, update: if hasValidExternalPlanPlacement(userId)
          && placementId == 'current'
          && request.resource.data.planId == planId;
        allow delete: if isOwner(userId);
      }
    }

    match /users/{userId}/plan_blocks/{blockId} {
      allow read: if isOwner(userId);
      allow create: if hasValidPlanBlock(userId);
      allow update: if hasValidPlanBlock(userId)
        && keepsOwnership(userId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
    }

    function hasValidTrainingIntentProfile(userId) {
      let data = request.resource.data;
      let commitment = data.weeklyCommitment;
      return hasOwnedUserId(userId)
        && data.keys().hasOnly(['userId', 'planningMode', 'priorities', 'weeklyCommitment', 'organizationPreference', 'schemaVersion', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['userId', 'planningMode', 'priorities', 'weeklyCommitment', 'organizationPreference', 'schemaVersion', 'createdAt', 'updatedAt'])
        && data.planningMode in ['evergreen', 'event_directed', 'externally_planned']
        && data.priorities is list && data.priorities.size() <= 6
        && data.weeklyCommitment is map
        && commitment.keys().hasOnly(['minSessions', 'targetSessions', 'maxSessions'])
        && commitment.keys().hasAll(['minSessions', 'targetSessions', 'maxSessions'])
        && commitment.minSessions is int && commitment.minSessions >= 1 && commitment.minSessions <= 14
        && commitment.targetSessions is int && commitment.targetSessions >= commitment.minSessions && commitment.targetSessions <= 14
        && commitment.maxSessions is int && commitment.maxSessions >= commitment.targetSessions && commitment.maxSessions <= 14
        && data.organizationPreference == 'auto'
        && data.schemaVersion is int && data.schemaVersion >= 1
        && data.createdAt is string && data.updatedAt is string;
    }

    match /users/{userId}/training_intent/profile {
      allow read: if isOwner(userId);
      allow create: if hasValidTrainingIntentProfile(userId);
      allow update: if hasValidTrainingIntentProfile(userId)
        && keepsOwnership(userId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/constraints/{constraintId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    function hasValidUnavailableModalities(data) {
      return !('unavailableModalities' in data)
        || (data.unavailableModalities is list
          && data.unavailableModalities.size() <= 6
          && data.unavailableModalities.hasOnly(['Running', 'Cycling', 'Strength', 'Field', 'Mobility', 'Cross Training']));
    }

    match /users/{userId}/preferences/profile {
      allow read: if isOwner(userId);
      allow create: if hasOwnedUserId(userId) && hasValidUnavailableModalities(request.resource.data);
      allow update: if keepsOwnership(userId) && request.resource.data.createdAt == resource.data.createdAt
        && hasValidUnavailableModalities(request.resource.data);
      allow delete: if false;
    }

    function hasValidInjuryList(injuries) {
      return injuries is list && injuries.size() <= 20;
    }

    match /users/{userId}/trainingSettings/profile {
      allow read: if isOwner(userId);
      allow create: if hasOwnedUserId(userId)
        && request.resource.data.schemaVersion in [2, 3]
        && (!('injuries' in request.resource.data) || hasValidInjuryList(request.resource.data.injuries));
      allow update: if keepsOwnership(userId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.schemaVersion in [2, 3]
        && (!('injuries' in request.resource.data) || hasValidInjuryList(request.resource.data.injuries));
      allow delete: if false;
    }

    match /users/{userId}/daily_recovery_snapshots/{date} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/activities/{activityId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // --- Strength session logging (ADR-0021, S1.3): the raw per-set log (D-SETLOG). Unlike
    // every collection above, this document holds variable-length nested arrays
    // (exercises[].sets[]) whose per-element fields (weightKg, reps, gauge, ...) this rules
    // language cannot validate -- there is no per-element iteration/predicate construct over
    // a `list` here, only `is list` and `.size()`, which is why every other array-of-maps
    // field in this file (external_plans' `sessions`, plan_blocks' `assignments`) is bounded
    // the same way rather than deep-validated. Structural bounds are enforced here; per-set
    // correctness is enforced defensively on read by
    // persistence/parsers/strengthSession.ts's parseStrengthSession, which drops a malformed
    // set or exercise rather than trusting it -- the read side is the actual gate for
    // per-element data quality, not these rules.
    function isStrengthSessionDocument(sessionId) {
      return request.resource.data.sessionId == sessionId;
    }

    function hasValidStrengthSession(userId, sessionId) {
      let data = request.resource.data;
      return hasOwnedUserId(userId)
        && isStrengthSessionDocument(sessionId)
        && data.keys().hasOnly(['userId', 'sessionId', 'date', 'startedAt', 'completedAt', 'updatedAt', 'state', 'sourceRecommendationDate', 'exercises', 'sessionRpe', 'notes', 'schemaVersion'])
        && data.keys().hasAll(['userId', 'sessionId', 'date', 'startedAt', 'updatedAt', 'state', 'exercises', 'schemaVersion'])
        && data.sessionId is string && data.sessionId.size() > 0 && data.sessionId.size() <= 128
        && isValidActivityDate(data.date)
        && data.startedAt is string && data.startedAt.size() > 0
        && data.updatedAt is string && data.updatedAt.size() > 0
        && (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() > 0))
        && data.state in ['in_progress', 'completed', 'abandoned']
        // Completion time belongs only to a completed session. An abandoned session keeps
        // its sets but was never completed; an in-progress session has not closed yet.
        && ((data.state == 'completed') == ('completedAt' in data))
        && (!('sourceRecommendationDate' in data) || isValidActivityDate(data.sourceRecommendationDate))
        && data.exercises is list && data.exercises.size() <= 30
        && (!('sessionRpe' in data) || (data.sessionRpe is number && data.sessionRpe >= 0 && data.sessionRpe <= 10))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && data.schemaVersion == 1;
    }

    match /users/{userId}/strength_sessions/{sessionId} {
      allow read: if isOwner(userId);
      allow create: if hasValidStrengthSession(userId, sessionId)
        && request.resource.data.state == 'in_progress';
      // date and startedAt are fixed at creation (ADR-0021: date is the Warsaw-local date
      // of session START, never recomputed) -- an update may append sets, change state, and
      // advance updatedAt/completedAt, but may not rewrite when the session started or which
      // calendar day it belongs to.
      allow update: if hasValidStrengthSession(userId, sessionId)
        && keepsOwnership(userId)
        // `completed` and `abandoned` are terminal. This is an integrity property, not a
        // UI convention: a closed record may already have updated 1RM history or supplied
        // a replayable exposure, so changing its sets/state would rewrite history.
        && resource.data.state == 'in_progress'
        && request.resource.data.date == resource.data.date
        && request.resource.data.startedAt == resource.data.startedAt;
      // Unlike decision_journal (an audited record), a mis-started session is the athlete's
      // own workout log and must be removable -- matches goals' allow delete precedent.
      allow delete: if isOwner(userId);
    }

    function hasValidGarminQueuedWorkout(userId, date) {
      let data = request.resource.data;
      return hasOwnedUserId(userId)
        && isDateDocument(date)
        && data.keys().hasOnly(['userId', 'date', 'workoutTitle', 'modality', 'status', 'queuedAt', 'syncedAt', 'error', 'payload', 'garminWorkoutId'])
        && data.keys().hasAll(['userId', 'date', 'workoutTitle', 'modality', 'status', 'queuedAt', 'payload'])
        && data.workoutTitle is string && data.workoutTitle.size() <= 200
        && data.modality is string && data.modality.size() <= 64
        && data.status in ['pending', 'synced', 'failed']
        && data.queuedAt is string
        && (!('syncedAt' in data) || data.syncedAt == null || data.syncedAt is string)
        && (!('error' in data) || data.error == null || (data.error is string && data.error.size() <= 2000))
        && (!('garminWorkoutId' in data) || data.garminWorkoutId is string)
        && data.payload is map;
    }

    match /users/{userId}/garmin_workout_queue/{date} {
      allow read: if isOwner(userId);
      allow create: if hasValidGarminQueuedWorkout(userId, date);
      allow update: if hasValidGarminQueuedWorkout(userId, date)
        && keepsOwnership(userId);
      allow delete: if isOwner(userId);
    }

    function hasValidSessionDefinitionHeader(userId, definitionId) {
      let data = request.resource.data;
      return hasOwnedUserId(userId)
        && data.keys().hasOnly(['userId', 'definitionId', 'title', 'latestRevision', 'dominantModality', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['userId', 'definitionId', 'title', 'latestRevision', 'createdAt', 'updatedAt'])
        && data.definitionId == definitionId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.latestRevision is int && data.latestRevision >= 1
        && (!('dominantModality' in data) || data.dominantModality is string)
        && data.createdAt is string && data.updatedAt is string;
    }

    function hasValidSessionDefinitionRevision(userId, definitionId, revId) {
      let data = request.resource.data;
      return hasOwnedUserId(userId)
        && data.keys().hasOnly(['userId', 'definitionId', 'schemaVersion', 'id', 'revision', 'title', 'summary', 'intent', 'modalities', 'dominantModality', 'duration', 'defaultScheduledDate', 'sessionTargets', 'prohibitedAdditions', 'importWarnings', 'blocks', 'contentHash', 'createdAt'])
        && data.keys().hasAll(['userId', 'definitionId', 'id', 'revision', 'schemaVersion', 'title', 'intent', 'contentHash', 'blocks', 'createdAt'])
        && data.definitionId == definitionId
        && data.id == definitionId
        && data.revision is int && string(data.revision) == revId
        && data.schemaVersion == 1
        && data.contentHash is string && data.contentHash.size() > 0
        && data.intent in ['training', 'testing', 'competition', 'rehab_return', 'recovery', 'skill_technical']
        && data.blocks is list;
    }

    match /users/{userId}/session_definitions/{definitionId} {
      allow read: if isOwner(userId);
      allow create: if hasValidSessionDefinitionHeader(userId, definitionId);
      allow update: if hasValidSessionDefinitionHeader(userId, definitionId)
        && keepsOwnership(userId)
        && request.resource.data.latestRevision >= resource.data.latestRevision
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);

      match /revisions/{revId} {
        allow read: if isOwner(userId);
        allow create: if hasValidSessionDefinitionRevision(userId, definitionId, revId);
        allow update, delete: if false;
      }
    }

    function hasValidSessionOccurrence(userId, occurrenceId) {
      let data = request.resource.data;
      return hasOwnedUserId(userId)
        && data.keys().hasOnly(['userId', 'occurrenceId', 'date', 'authority', 'definitionRef', 'state', 'placementOrder', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['userId', 'occurrenceId', 'date', 'authority', 'definitionRef', 'state', 'createdAt', 'updatedAt'])
        && data.occurrenceId == occurrenceId
        && isValidActivityDate(data.date)
        // M3.3: supports unplanned_log, schedule, replace_recommendation, and additional_session
        && data.authority in ['unplanned_log', 'schedule', 'replace_recommendation', 'additional_session']
        && data.state in ['scheduled', 'active', 'superseded', 'completed', 'abandoned', 'missed']
        && data.definitionRef is map
        && data.definitionRef.keys().hasOnly(['definitionId', 'revision', 'contentHash'])
        && data.definitionRef.keys().hasAll(['definitionId', 'revision', 'contentHash'])
        && data.definitionRef.definitionId is string && data.definitionRef.definitionId.size() > 0
        && data.definitionRef.revision is int && data.definitionRef.revision >= 1
        && data.definitionRef.contentHash is string && data.definitionRef.contentHash.size() > 0
        && (!('placementOrder' in data) || (data.placementOrder is int && data.placementOrder >= 0))
        && data.createdAt is string && data.updatedAt is string;
    }

    match /users/{userId}/session_occurrences/{occurrenceId} {
      allow read: if isOwner(userId);
      allow create: if hasValidSessionOccurrence(userId, occurrenceId);
      allow update: if hasValidSessionOccurrence(userId, occurrenceId)
        && keepsOwnership(userId)
        && request.resource.data.date == resource.data.date
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.definitionRef == resource.data.definitionRef
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    // M3.2: optional snapshot of the non-`blocks` fields `definitionHash` was computed
    // over, so a `catalog` source can be replayed with historical fidelity after its live
    // catalog entry is later edited. Absent on prescriptions written before this existed.
    function hasValidDisplayMetadata(meta) {
      return meta is map
        && meta.keys().hasOnly(['title', 'summary', 'intent', 'dominantModality', 'duration'])
        && meta.keys().hasAll(['title', 'intent'])
        && meta.title is string
        && meta.intent is string
        && (!('summary' in meta) || meta.summary is string)
        && (!('dominantModality' in meta) || meta.dominantModality is string)
        && (!('duration' in meta) || (meta.duration is map && meta.duration.min is number && meta.duration.max is number));
    }

    function hasValidExecutionPrescription(userId, prescriptionHash) {
      let data = request.resource.data;
      return hasOwnedUserId(userId)
        && data.keys().hasOnly(['userId', 'schemaVersion', 'prescriptionHash', 'sessionSource', 'definitionHash', 'blocks', 'displayMetadata', 'createdAt'])
        && data.keys().hasAll(['userId', 'schemaVersion', 'prescriptionHash', 'sessionSource', 'definitionHash', 'blocks', 'createdAt'])
        && data.prescriptionHash == prescriptionHash
        && data.definitionHash is string
        && hasValidSessionSource(data.sessionSource)
        && data.schemaVersion == 1
        && data.blocks is list
        && (!('displayMetadata' in data) || hasValidDisplayMetadata(data.displayMetadata))
        && data.createdAt is string;
    }

    match /users/{userId}/execution_prescriptions/{prescriptionHash} {
      allow read: if isOwner(userId);
      allow create: if hasValidExecutionPrescription(userId, prescriptionHash);
      allow update, delete: if false;
    }

    function hasValidSessionExecution(userId, executionId) {
      let data = request.resource.data;
      return hasOwnedUserId(userId)
        && data.keys().hasOnly(['userId', 'executionId', 'occurrenceId', 'sessionSource', 'prescriptionHash', 'date', 'startedAt', 'completedAt', 'updatedAt', 'state', 'sessionRpe', 'notes', 'schemaVersion'])
        && data.keys().hasAll(['userId', 'executionId', 'sessionSource', 'date', 'startedAt', 'updatedAt', 'state', 'schemaVersion'])
        && data.executionId == executionId
        && isValidActivityDate(data.date)
        && hasValidSessionSource(data.sessionSource)
        && (!('occurrenceId' in data) || data.occurrenceId is string)
        && (!('prescriptionHash' in data) || data.prescriptionHash is string)
        && (!('sessionRpe' in data) || (data.sessionRpe is number && data.sessionRpe >= 1 && data.sessionRpe <= 10))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000))
        && data.state in ['in_progress', 'completed', 'abandoned']
        && ((data.state == 'completed') == ('completedAt' in data))
        && data.startedAt is string
        && data.updatedAt is string
        && data.schemaVersion == 1;
    }

    function hasValidSessionSource(source) {
      return source is map && (
        (source.kind == 'catalog'
          && source.keys().hasOnly(['kind', 'workoutId', 'catalogVersion'])
          && source.keys().hasAll(['kind', 'workoutId', 'catalogVersion'])
          && source.workoutId is string && source.catalogVersion is string)
        || (source.kind == 'external_plan'
          && source.keys().hasOnly(['kind', 'planId', 'revision', 'sessionId', 'contentHash'])
          && source.keys().hasAll(['kind', 'planId', 'revision', 'sessionId', 'contentHash'])
          && source.planId is string && source.revision is int && source.revision >= 1
          && source.sessionId is string && source.contentHash is string)
        || (source.kind == 'manual'
          && source.keys().hasOnly(['kind', 'definitionId', 'revision', 'contentHash'])
          && source.keys().hasAll(['kind', 'definitionId', 'revision', 'contentHash'])
          && source.definitionId is string && source.revision is int && source.revision >= 1 && source.contentHash is string)
        || (source.kind == 'unplanned_fixture'
          && source.keys().hasOnly(['kind', 'fixtureId'])
          && source.keys().hasAll(['kind', 'fixtureId'])
          && source.fixtureId is string)
      );
    }

    function hasValidSessionReferenceBinding(binding) {
      return binding is map
        && binding.keys().hasOnly(['sessionSource', 'occurrenceId', 'prescriptionHash'])
        && binding.keys().hasAll(['sessionSource', 'prescriptionHash'])
        && hasValidSessionSource(binding.sessionSource)
        && binding.prescriptionHash is string && binding.prescriptionHash.size() > 0
        && (!('occurrenceId' in binding) || (binding.occurrenceId is string && binding.occurrenceId.size() > 0));
    }

    // Lighter than hasValidSessionSource: checks the recognized source kind plus presence
    // of that kind's required fields, but skips hasOnly() (no rejection of stray extra
    // fields) and per-field type/size checks (e.g. catalogVersion being a string) -- see
    // hasValidAdditionalSessions for why. The client (engine/validation.ts) still applies
    // the full per-kind check before any write reaches here; this is defense in depth
    // against a client that skips it, not the only gate. This still closes the specific
    // gap of a binding that names a valid `kind` but omits that kind's required fields
    // entirely (e.g. `{ kind: 'catalog' }` with no workoutId/catalogVersion).
    function hasValidAdditionalSessionSourceShape(source) {
      return source is map && (
        (source.kind == 'catalog' && source.keys().hasAll(['workoutId', 'catalogVersion']))
        || (source.kind == 'external_plan' && source.keys().hasAll(['planId', 'revision', 'sessionId', 'contentHash']))
        || (source.kind == 'manual' && source.keys().hasAll(['definitionId', 'revision', 'contentHash']))
        || (source.kind == 'unplanned_fixture' && source.keys().hasAll(['fixtureId']))
      );
    }

    function hasValidAdditionalSessionBinding(binding) {
      return binding is map
        && binding.keys().hasOnly(['sessionSource', 'occurrenceId', 'prescriptionHash'])
        && binding.keys().hasAll(['sessionSource', 'prescriptionHash'])
        && hasValidAdditionalSessionSourceShape(binding.sessionSource)
        && binding.prescriptionHash is string && binding.prescriptionHash.size() > 0
        && (!('occurrenceId' in binding) || (binding.occurrenceId is string && binding.occurrenceId.size() > 0));
    }

    // Bounded to 4 (not the schema's historical 16): the rules language has no
    // iteration, so per-element validation is unrolled by index below. A prior attempt
    // at this same check unrolled to 16 elements calling the full hasValidSessionReferenceBinding
    // per element and exceeded the emulator's ~1000 expression-evaluation budget per write;
    // 4 elements at that same per-kind rigor still didn't fit even after removing other
    // redundant evaluation (see canUpdateRecommendation's comment), hence the lighter
    // per-element check above. 4 is a real bound, not a compromise -- adjudicateAuthoredSession's
    // systemic-cost ceiling never admits more than a handful of same-day sessions in
    // practice (see authoredSessionGates.ts).
    function hasValidAdditionalSessions(list) {
      return list is list && list.size() <= 4
        && (list.size() < 1 || hasValidAdditionalSessionBinding(list[0]))
        && (list.size() < 2 || hasValidAdditionalSessionBinding(list[1]))
        && (list.size() < 3 || hasValidAdditionalSessionBinding(list[2]))
        && (list.size() < 4 || hasValidAdditionalSessionBinding(list[3]));
    }

    function hasValidSessionEntry(executionId, entryId) {
      let data = request.resource.data;
      let payload = data.payload;
      return data.keys().hasOnly(['id', 'executionId', 'stepId', 'exerciseRef', 'side', 'selectedOptionId', 'completedAt', 'createdAt', 'updatedAt', 'payload'])
        && data.keys().hasAll(['id', 'executionId', 'completedAt', 'createdAt', 'updatedAt', 'payload'])
        && data.id == entryId
        && data.executionId == executionId
        && data.completedAt is string && data.createdAt is string && data.updatedAt is string
        && (!('stepId' in data) || data.stepId is string)
        && (!('selectedOptionId' in data) || data.selectedOptionId is string)
        && (!('side' in data) || data.side in ['left', 'right', 'bilateral'])
        && payload is map
        && (
          (payload.kind == 'repetition'
            && payload.keys().hasOnly(['kind', 'setIndex', 'reps', 'weightKg', 'isWarmup', 'gauge'])
            && payload.setIndex is int && payload.setIndex >= 1
            && payload.reps is int && payload.reps >= 1
            && (!('weightKg' in payload) || (payload.weightKg is number && payload.weightKg >= 0))
            && (!('isWarmup' in payload) || payload.isWarmup is bool))
          || (payload.kind == 'duration'
            && payload.keys().hasOnly(['kind', 'seconds', 'loadKg', 'position'])
            && payload.seconds is number && payload.seconds > 0
            && (!('loadKg' in payload) || (payload.loadKg is number && payload.loadKg >= 0)))
          || (payload.kind == 'distance'
            && payload.keys().hasOnly(['kind', 'meters', 'durationSeconds'])
            && payload.meters is number && payload.meters > 0
            && (!('durationSeconds' in payload) || (payload.durationSeconds is number && payload.durationSeconds > 0)))
          || (payload.kind == 'sprint'
            && payload.keys().hasOnly(['kind', 'meters', 'splitSeconds', 'surface'])
            && payload.meters is number && payload.meters > 0
            && payload.splitSeconds is number && payload.splitSeconds > 0)
          || (payload.kind == 'jump_attempt'
            && payload.keys().hasOnly(['kind', 'attemptIndex', 'heightInches', 'distanceMeters'])
            && payload.attemptIndex is int && payload.attemptIndex >= 1
            && (('heightInches' in payload && payload.heightInches is number && payload.heightInches > 0)
              || ('distanceMeters' in payload && payload.distanceMeters is number && payload.distanceMeters > 0)))
          || (payload.kind == 'checkoff'
            && payload.keys().hasOnly(['kind', 'roundIndex', 'completed'])
            && payload.completed is bool
            && (!('roundIndex' in payload) || (payload.roundIndex is int && payload.roundIndex >= 1)))
          || (payload.kind == 'choice'
            && payload.keys().hasOnly(['kind', 'choiceId', 'optionId', 'reason'])
            && payload.choiceId is string && payload.choiceId.size() > 0
            && payload.optionId is string && payload.optionId.size() > 0
            && (!('reason' in payload) || payload.reason is string))
        );
    }

    match /users/{userId}/session_executions/{executionId} {
      allow read: if isOwner(userId);
      allow create: if hasValidSessionExecution(userId, executionId)
        && request.resource.data.state == 'in_progress';
      allow update: if hasValidSessionExecution(userId, executionId)
        && keepsOwnership(userId)
        && resource.data.state == 'in_progress'
        && request.resource.data.date == resource.data.date
        && request.resource.data.startedAt == resource.data.startedAt;
      allow delete: if isOwner(userId);

      match /entries/{entryId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId)
          && get(/databases/$(database)/documents/users/$(userId)/session_executions/$(executionId)).data.state == 'in_progress'
          && (request.method == 'delete' || hasValidSessionEntry(executionId, entryId));
      }
    }

    // M5.1: SessionResponse -- linkage plus non-tissue session facts only (D-MRESP).
    // DailySubjectiveCheckin.tissueResponses remains the sole tissue authority; this
    // record never carries a tissue value.
    function hasValidSessionResponse(userId, responseId) {
      let data = request.resource.data;
      return hasOwnedUserId(userId)
        && data.keys().hasOnly(['userId', 'responseId', 'sourceSession', 'occurrenceId', 'window', 'date', 'checkinRef', 'sessionRpe', 'completedFraction', 'unexpectedFatigue', 'techniqueNote', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['userId', 'responseId', 'sourceSession', 'window', 'date', 'checkinRef', 'createdAt', 'updatedAt'])
        && data.responseId == responseId
        && data.sourceSession is map
        && data.sourceSession.keys().hasOnly(['kind', 'id', 'date'])
        && data.sourceSession.keys().hasAll(['kind', 'id', 'date'])
        && data.sourceSession.kind in ['strength', 'execution']
        && data.sourceSession.id is string && data.sourceSession.id.size() > 0
        && isValidActivityDate(data.sourceSession.date)
        && data.window in ['immediate', 'later_day', 'next_morning']
        && isValidActivityDate(data.date)
        // `date` equals sourceSession.date for `immediate`, strictly later otherwise
        // (models.ts's own documented invariant) -- ISO YYYY-MM-DD strings compare
        // lexicographically the same as chronologically.
        && (data.window == 'immediate' ? data.date == data.sourceSession.date : data.date > data.sourceSession.date)
        && data.checkinRef is map
        && data.checkinRef.keys().hasOnly(['date'])
        && isValidActivityDate(data.checkinRef.date)
        && (!('occurrenceId' in data) || (
          data.occurrenceId is string && data.occurrenceId.size() > 0
          // Cannot reference another user's occurrence: it must exist under this same
          // user's own path -- a cross-user id structurally cannot resolve here.
          && exists(/databases/$(database)/documents/users/$(userId)/session_occurrences/$(data.occurrenceId))
        ))
        && (!('sessionRpe' in data) || (data.sessionRpe is number && data.sessionRpe >= 0 && data.sessionRpe <= 10))
        && (!('completedFraction' in data) || (data.completedFraction is number && data.completedFraction >= 0 && data.completedFraction <= 1))
        && (!('unexpectedFatigue' in data) || data.unexpectedFatigue is bool)
        && (!('techniqueNote' in data) || (data.techniqueNote is string && data.techniqueNote.size() <= 2000))
        && (!('note' in data) || (data.note is string && data.note.size() <= 2000))
        && data.createdAt is string && data.updatedAt is string;
    }

    match /users/{userId}/session_responses/{responseId} {
      allow read: if isOwner(userId);
      allow create: if hasValidSessionResponse(userId, responseId);
      allow update: if hasValidSessionResponse(userId, responseId)
        && keepsOwnership(userId)
        // Edits preserve provenance: identity/occurrence/window/createdAt never change
        // after creation -- only the non-tissue facts and updatedAt may be revised.
        // occurrenceId's presence and value are both pinned (not just its value when
        // present), so a response created without one can't have one added later either.
        && request.resource.data.sourceSession == resource.data.sourceSession
        && ('occurrenceId' in request.resource.data) == ('occurrenceId' in resource.data)
        && (!('occurrenceId' in resource.data) || request.resource.data.occurrenceId == resource.data.occurrenceId)
        && request.resource.data.window == resource.data.window
        && request.resource.data.date == resource.data.date
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
    }

    // The browser may only ever (re-)queue a fresh 'pending' request -- 'processing',
    // 'completed', 'failed', and the claimId/claimedAt fields are produced solely by
    // poll_manual_sync_requests's Admin SDK writes, which bypass these rules entirely.
    // A client cannot self-report a sync outcome it never ran.
    function hasValidGarminSyncRequest(userId) {
      let data = request.resource.data;
      return hasOwnedUserId(userId)
        && data.keys().hasOnly(['userId', 'status', 'requestedAt', 'completedAt', 'error'])
        && data.keys().hasAll(['userId', 'status', 'requestedAt'])
        && data.status == 'pending'
        && data.requestedAt is string
        && (!('completedAt' in data) || data.completedAt == null)
        && (!('error' in data) || data.error == null);
    }

    // A manual "Sync Now" request (D-GARMINSYNC): the web app writes a single fixed-id
    // doc to ask the garmin_sync poller (see poll_manual_sync_requests) to run an
    // immediate forced sync rather than waiting for the next scheduled tick. Single
    // outstanding request per user, mirroring garmin_workout_queue's per-item status
    // convention -- the poller (Admin SDK, bypasses these rules) is what actually
    // claims the request ('processing') and transitions it to 'completed'/'failed'.
    match /users/{userId}/garmin_sync_requests/{requestId} {
      allow read: if isOwner(userId);
      allow create, update: if hasValidGarminSyncRequest(userId) && requestId == 'latest';
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/daily_recommendations/{date} {
      allow read: if isOwner(userId);
      allow create: if hasValidRecommendation(userId, date);
      allow update: if isValidAdherenceOnlyUpdate(userId, date) || canUpdateRecommendation(userId, date);
      allow delete: if false;

      match /revisions/{revId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.revision is int
          && string(request.resource.data.revision) == revId;
        allow update, delete: if false;
      }
    }

    // --- Performance outcome validation (M7 / OV2): raw evidence only. These rules do
    // not create progress labels, block verdicts, or recommendation-selection authority.
    function hasKnownOutcomeMetric(metricId) {
      return metricId in [
        'cycling_tt_20m_mean_power_w',
        'cycling_tt_4m_mean_power_w',
        'cycling_submax_mean_hr_bpm',
        'cycling_submax_rpe'
      ];
    }

    function hasValidOutcomeMetricUnit(metricId, unit) {
      return (metricId in ['cycling_tt_20m_mean_power_w', 'cycling_tt_4m_mean_power_w'] && unit == 'W')
        || (metricId == 'cycling_submax_mean_hr_bpm' && unit == 'bpm')
        || (metricId == 'cycling_submax_rpe' && unit == 'rpe');
    }

    function hasValidProtocolRef(userId, protocolRef) {
      let protocolPath = /databases/$(database)/documents/users/$(userId)/measurement_protocols/$(protocolRef.id)/revisions/$(string(protocolRef.revision));
      return protocolRef is map
        && protocolRef.keys().hasOnly(['id', 'revision'])
        && protocolRef.keys().hasAll(['id', 'revision'])
        && protocolRef.id is string && protocolRef.id.size() > 0 && protocolRef.id.size() <= 128
        && protocolRef.revision is int && protocolRef.revision >= 1
        && exists(protocolPath);
    }

    function hasValidMeasurementProtocol(userId, protocolId, revisionId) {
      let data = request.resource.data;
      let comparison = data.comparisonContext;
      let familiarization = data.familiarization;
      let dimensions = ['power_source_id', 'bike_setup_id', 'test_environment', 'course_or_trainer_id', 'duration_seconds', 'start_mode', 'warmup_revision', 'feedback_rule', 'weather_note'];
      return isOwner(userId)
        && data.keys().hasOnly(['id', 'revision', 'title', 'intent', 'metricIds', 'instructions', 'warmupRef', 'comparisonContext', 'familiarization', 'burden', 'expectedRecoveryHours', 'invalidationRules', 'createdAt'])
        && data.keys().hasAll(['id', 'revision', 'title', 'intent', 'metricIds', 'instructions', 'comparisonContext', 'familiarization', 'burden', 'invalidationRules', 'createdAt'])
        && data.id == protocolId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.revision is int && data.revision >= 1 && string(data.revision) == revisionId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.intent == 'testing'
        && data.metricIds is list && data.metricIds.size() >= 1 && data.metricIds.size() <= 8
        && data.metricIds.hasOnly(['cycling_tt_20m_mean_power_w', 'cycling_tt_4m_mean_power_w', 'cycling_submax_mean_hr_bpm', 'cycling_submax_rpe'])
        && data.instructions is list && data.instructions.size() <= 64
        && (!('warmupRef' in data) || (data.warmupRef is string && data.warmupRef.size() > 0 && data.warmupRef.size() <= 128))
        && comparison is map
        && comparison.keys().hasOnly(['required', 'seriesDefining', 'contextOnly', 'canonicalizationVersion'])
        && comparison.keys().hasAll(['required', 'seriesDefining', 'contextOnly', 'canonicalizationVersion'])
        && comparison.required is list && comparison.required.size() <= 16 && comparison.required.hasOnly(dimensions)
        && comparison.seriesDefining is list && comparison.seriesDefining.size() <= 16 && comparison.seriesDefining.hasOnly(comparison.required)
        && comparison.contextOnly is list && comparison.contextOnly.size() <= 16 && comparison.contextOnly.hasOnly(comparison.required)
        && !comparison.seriesDefining.hasAny(comparison.contextOnly)
        && comparison.required.size() <= comparison.seriesDefining.size() + comparison.contextOnly.size()
        && comparison.canonicalizationVersion is string && comparison.canonicalizationVersion.size() > 0 && comparison.canonicalizationVersion.size() <= 64
        && familiarization is map
        && familiarization.keys().hasOnly(['required', 'minimumExposures'])
        && familiarization.keys().hasAll(['required', 'minimumExposures'])
        && familiarization.required is bool
        && familiarization.minimumExposures is int && familiarization.minimumExposures >= 0 && familiarization.minimumExposures <= 20
        && (!familiarization.required || familiarization.minimumExposures >= 1)
        && data.burden in ['low', 'moderate', 'high']
        && (!('expectedRecoveryHours' in data) || (data.expectedRecoveryHours is number && data.expectedRecoveryHours >= 0 && data.expectedRecoveryHours <= 336))
        && data.invalidationRules is list && data.invalidationRules.size() <= 32
        && data.createdAt is string && data.createdAt.size() > 0;
    }

    match /users/{userId}/measurement_protocols/{protocolId}/revisions/{revisionId} {
      allow read: if isOwner(userId);
      allow create: if hasValidMeasurementProtocol(userId, protocolId, revisionId);
      allow update, delete: if false;
    }

    function hasValidAssessmentAttempt(userId, attemptId) {
      let data = request.resource.data;
      return isOwner(userId)
        && data.keys().hasOnly(['id', 'protocolRef', 'scheduledDate', 'startedAt', 'completedAt', 'state', 'purpose', 'sourceSessionRef', 'notes'])
        && data.keys().hasAll(['id', 'protocolRef', 'state', 'purpose'])
        && data.id == attemptId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 160
        && hasValidProtocolRef(userId, data.protocolRef)
        && data.state in ['scheduled', 'in_progress', 'completed', 'abandoned']
        && data.purpose in ['familiarization', 'baseline', 'checkpoint', 'post_block']
        && (!('scheduledDate' in data) || isValidActivityDate(data.scheduledDate))
        && (!('startedAt' in data) || (data.startedAt is string && data.startedAt.size() > 0))
        && (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() > 0))
        && (!('sourceSessionRef' in data) || (data.sourceSessionRef is string && data.sourceSessionRef.size() > 0 && data.sourceSessionRef.size() <= 256))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000))
        && (data.state != 'scheduled' || (!('startedAt' in data) && !('completedAt' in data)))
        && (data.state != 'in_progress' || (('startedAt' in data) && !('completedAt' in data)))
        && (data.state != 'completed' || (('startedAt' in data) && ('completedAt' in data)))
        && (data.state != 'abandoned' || !('completedAt' in data));
    }

    function hasValidAssessmentAttemptTransition() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.protocolRef == resource.data.protocolRef
        && request.resource.data.purpose == resource.data.purpose
        && (('scheduledDate' in request.resource.data) == ('scheduledDate' in resource.data))
        && (!('scheduledDate' in resource.data) || request.resource.data.scheduledDate == resource.data.scheduledDate)
        && (!('startedAt' in resource.data) || request.resource.data.startedAt == resource.data.startedAt)
        && (!('completedAt' in resource.data) || request.resource.data.completedAt == resource.data.completedAt)
        && (
          request.resource.data.state == resource.data.state
          || (resource.data.state == 'scheduled' && request.resource.data.state in ['in_progress', 'abandoned'])
          || (resource.data.state == 'in_progress' && request.resource.data.state in ['completed', 'abandoned'])
        );
    }

    match /users/{userId}/assessment_attempts/{attemptId} {
      allow read: if isOwner(userId);
      allow create: if hasValidAssessmentAttempt(userId, attemptId);
      allow update: if hasValidAssessmentAttempt(userId, attemptId)
        && hasValidAssessmentAttemptTransition();
      allow delete: if false;
    }

    function observationHeadAfterRevision(userId, observationKey, revision) {
      let headPath = /databases/$(database)/documents/users/$(userId)/metric_observations/$(observationKey);
      let head = getAfter(headPath).data;
      return head.observationKey == observationKey && head.headRevision == revision;
    }

    function revisionAfterHead(userId, observationKey, revision) {
      let revisionPath = /databases/$(database)/documents/users/$(userId)/metric_observations/$(observationKey)/revisions/$(string(revision));
      let next = getAfter(revisionPath).data;
      return next.observationKey == observationKey && next.revision == revision;
    }

    function hasValidObservationHead(userId, observationKey) {
      let data = request.resource.data;
      return isOwner(userId)
        && data.keys().hasOnly(['observationKey', 'assessmentAttemptId', 'metricId', 'headRevision', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['observationKey', 'assessmentAttemptId', 'metricId', 'headRevision', 'createdAt', 'updatedAt'])
        && data.observationKey == observationKey
        && data.assessmentAttemptId is string && data.assessmentAttemptId.size() > 0 && data.assessmentAttemptId.size() <= 160
        && hasKnownOutcomeMetric(data.metricId)
        && data.observationKey == data.assessmentAttemptId + ':' + data.metricId
        && data.headRevision is int && data.headRevision >= 1
        && data.createdAt is string && data.createdAt.size() > 0
        && data.updatedAt is string && data.updatedAt.size() > 0;
    }

    function hasValidObservationDevice(device) {
      return device is map
        && device.keys().hasOnly(['provider', 'model', 'deviceId'])
        && device.keys().hasAll(['provider'])
        && device.provider is string && device.provider.size() > 0 && device.provider.size() <= 128
        && (!('model' in device) || (device.model is string && device.model.size() > 0 && device.model.size() <= 128))
        && (!('deviceId' in device) || (device.deviceId is string && device.deviceId.size() > 0 && device.deviceId.size() <= 256));
    }

    function hasValidObservationProtocolBinding(userId, data) {
      let protocolPath = /databases/$(database)/documents/users/$(userId)/measurement_protocols/$(data.protocolRef.id)/revisions/$(string(data.protocolRef.revision));
      let attemptPath = /databases/$(database)/documents/users/$(userId)/assessment_attempts/$(data.assessmentAttemptId);
      return hasValidProtocolRef(userId, data.protocolRef)
        && exists(attemptPath)
        && get(attemptPath).data.protocolRef == data.protocolRef
        && get(protocolPath).data.metricIds.hasAny([data.metricId])
        && get(protocolPath).data.comparisonContext.canonicalizationVersion == data.comparisonCanonicalizationVersion;
    }

    function hasValidMetricObservationRevision(userId, observationKey, revisionId) {
      let data = request.resource.data;
      return isOwner(userId)
        && data.keys().hasOnly(['observationKey', 'revision', 'supersedesRevision', 'metricId', 'value', 'unit', 'observedAt', 'source', 'sourceRef', 'device', 'protocolRef', 'comparisonSeriesKey', 'comparisonCanonicalizationVersion', 'assessmentAttemptId', 'validity', 'invalidReason', 'context', 'derivedFromObservationIds', 'algorithmVersion', 'correctionReason', 'createdAt'])
        && data.keys().hasAll(['observationKey', 'revision', 'metricId', 'value', 'unit', 'observedAt', 'source', 'protocolRef', 'comparisonSeriesKey', 'comparisonCanonicalizationVersion', 'assessmentAttemptId', 'validity', 'context', 'createdAt'])
        && data.observationKey == observationKey
        && data.assessmentAttemptId is string && data.assessmentAttemptId.size() > 0 && data.assessmentAttemptId.size() <= 160
        && data.observationKey == data.assessmentAttemptId + ':' + data.metricId
        && data.revision is int && data.revision >= 1 && string(data.revision) == revisionId
        && ((data.revision == 1 && !('supersedesRevision' in data) && !('correctionReason' in data))
          || (data.revision > 1
            && data.supersedesRevision is int && data.supersedesRevision == data.revision - 1
            && data.correctionReason is string && data.correctionReason.size() > 0 && data.correctionReason.size() <= 2000))
        && hasKnownOutcomeMetric(data.metricId)
        && data.value is number
        && hasValidOutcomeMetricUnit(data.metricId, data.unit)
        && data.observedAt is string && data.observedAt.size() > 0
        && data.source in ['manual', 'garmin_activity', 'garmin_lap', 'derived']
        && (!('sourceRef' in data) || (data.sourceRef is string && data.sourceRef.size() > 0 && data.sourceRef.size() <= 512))
        && (!('device' in data) || hasValidObservationDevice(data.device))
        && data.comparisonSeriesKey is string && data.comparisonSeriesKey.size() > 0 && data.comparisonSeriesKey.size() <= 128
        && data.comparisonCanonicalizationVersion is string && data.comparisonCanonicalizationVersion.size() > 0 && data.comparisonCanonicalizationVersion.size() <= 64
        && data.validity in ['valid', 'invalid', 'practice', 'questionable']
        && (data.validity != 'invalid' || ('invalidReason' in data))
        && (!('invalidReason' in data) || (data.invalidReason is string && data.invalidReason.size() > 0 && data.invalidReason.size() <= 2000))
        && data.context is map && data.context.size() <= 64
        && ((data.source == 'derived'
          && ('derivedFromObservationIds' in data) && data.derivedFromObservationIds is list && data.derivedFromObservationIds.size() >= 1 && data.derivedFromObservationIds.size() <= 32
          && ('algorithmVersion' in data) && data.algorithmVersion is string && data.algorithmVersion.size() > 0 && data.algorithmVersion.size() <= 128)
          || (data.source != 'derived' && !('derivedFromObservationIds' in data) && !('algorithmVersion' in data)))
        && data.createdAt is string && data.createdAt.size() > 0
        && hasValidObservationProtocolBinding(userId, data);
    }

    match /users/{userId}/metric_observations/{observationKey} {
      allow read: if isOwner(userId);
      allow create: if hasValidObservationHead(userId, observationKey)
        && request.resource.data.headRevision == 1
        && revisionAfterHead(userId, observationKey, 1);
      allow update: if hasValidObservationHead(userId, observationKey)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['headRevision', 'updatedAt'])
        && request.resource.data.headRevision == resource.data.headRevision + 1
        && revisionAfterHead(userId, observationKey, request.resource.data.headRevision);
      allow delete: if false;

      match /revisions/{revisionId} {
        allow read: if isOwner(userId);
        allow create: if hasValidMetricObservationRevision(userId, observationKey, revisionId)
          && observationHeadAfterRevision(userId, observationKey, request.resource.data.revision)
          && (
            (request.resource.data.revision == 1 && !exists(/databases/$(database)/documents/users/$(userId)/metric_observations/$(observationKey)))
            || (request.resource.data.revision > 1
              && get(/databases/$(database)/documents/users/$(userId)/metric_observations/$(observationKey)).data.headRevision == request.resource.data.supersedesRevision)
          );
        allow update, delete: if false;
      }
    }

    function hasValidCompetitionOutcome(userId, outcomeId) {
      let data = request.resource.data;
      let result = data.result;
      return isOwner(userId)
        && data.keys().hasOnly(['id', 'eventRef', 'sport', 'occurredAt', 'source', 'sourceRef', 'result', 'metrics', 'context', 'createdAt'])
        && data.keys().hasAll(['id', 'sport', 'occurredAt', 'source', 'result', 'metrics', 'context', 'createdAt'])
        && data.id == outcomeId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 160
        && (!('eventRef' in data) || (data.eventRef is string && data.eventRef.size() > 0 && data.eventRef.size() <= 256))
        && data.sport in ['cycling', 'running', 'field', 'other']
        && data.occurredAt is string && data.occurredAt.size() > 0
        && data.source in ['manual', 'garmin_activity', 'imported_result']
        && (!('sourceRef' in data) || (data.sourceRef is string && data.sourceRef.size() > 0 && data.sourceRef.size() <= 512))
        && result is map
        && result.keys().hasOnly(['completed', 'placing', 'fieldSize', 'elapsedSeconds', 'distanceM', 'courseId', 'summary'])
        && result.keys().hasAll(['completed'])
        && result.completed is bool
        && (!('placing' in result) || (result.placing is int && result.placing >= 1))
        && (!('fieldSize' in result) || (result.fieldSize is int && result.fieldSize >= 1))
        && (!('placing' in result) || !('fieldSize' in result) || result.placing <= result.fieldSize)
        && (!('elapsedSeconds' in result) || (result.elapsedSeconds is number && result.elapsedSeconds >= 0))
        && (!('distanceM' in result) || (result.distanceM is number && result.distanceM >= 0))
        && (!('courseId' in result) || (result.courseId is string && result.courseId.size() > 0 && result.courseId.size() <= 256))
        && (!('summary' in result) || (result.summary is string && result.summary.size() <= 4000))
        && data.metrics is map && data.metrics.size() <= 64
        && data.context is map && data.context.size() <= 64
        && data.createdAt is string && data.createdAt.size() > 0;
    }

    match /users/{userId}/competition_outcomes/{outcomeId} {
      allow read: if isOwner(userId);
      allow create: if hasValidCompetitionOutcome(userId, outcomeId);
      allow update, delete: if false;
    }
  }
}