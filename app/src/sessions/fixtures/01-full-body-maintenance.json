{
  "schemaVersion": 1,
  "id": "full-body-maintenance-01",
  "revision": 1,
  "title": "Full-Body Strength/Power Maintenance",
  "summary": "Full-body maintenance session with crisp bar speed, moderate volume, and no grinding.",
  "intent": "training",
  "modalities": [
    "strength",
    "power"
  ],
  "dominantModality": "strength",
  "duration": {
    "min": 45,
    "max": 55
  },
  "sessionTargets": [
    {
      "kind": "session_rpe_cap",
      "maxRpe": 7
    },
    {
      "kind": "technical_stop",
      "description": "Terminate any set where bar speed degrades noticeably"
    }
  ],
  "prohibitedAdditions": [
    "no additional heavy leg sets",
    "no failure grinding"
  ],
  "blocks": [
    {
      "id": "block-warmup",
      "title": "Movement Preparation & Activation",
      "role": "warmup",
      "executionMode": "circuit",
      "rounds": {
        "min": 2,
        "max": 2
      },
      "steps": [
        {
          "kind": "exercise",
          "id": "step-warmup-1",
          "exerciseRef": {
            "kind": "catalog",
            "exerciseId": "dead_bug"
          },
          "dose": {
            "kind": "repetition",
            "sets": 2,
            "reps": {
              "min": 8,
              "max": 8
            }
          },
          "laterality": "per_side",
          "rest": {
            "min": 30,
            "max": 45
          }
        },
        {
          "kind": "exercise",
          "id": "step-warmup-2",
          "exerciseRef": {
            "kind": "catalog",
            "exerciseId": "copenhagen_plank"
          },
          "dose": {
            "kind": "duration",
            "sets": 2,
            "seconds": {
              "min": 20,
              "max": 20
            }
          },
          "laterality": "per_side",
          "rest": {
            "min": 30,
            "max": 45
          }
        }
      ]
    },
    {
      "id": "block-power",
      "title": "Olympic Power Primer",
      "role": "main",
      "executionMode": "sequential",
      "optionSets": [
        {
          "id": "choice-clean-quality",
          "appliesAtStepId": "step-power-1",
          "trigger": {
            "kind": "athlete_observed",
            "description": "How are catch comfort and bar speed holding up?"
          },
          "options": [
            {
              "id": "continue-clean",
              "label": "Crisp and comfortable — continue",
              "actions": []
            },
            {
              "id": "reduce-clean-load",
              "label": "Quality is fading — reduce load 10%",
              "actions": [
                {
                  "kind": "reduce_load_percent",
                  "targetStepId": "step-power-1",
                  "percent": 10
                }
              ]
            },
            {
              "id": "end-clean-block",
              "label": "Catch is uncomfortable — end the block",
              "actions": [
                {
                  "kind": "end_block",
                  "targetBlockId": "block-power"
                }
              ]
            }
          ]
        }
      ],
      "steps": [
        {
          "kind": "exercise",
          "id": "step-power-1",
          "exerciseRef": {
            "kind": "catalog",
            "exerciseId": "hang_power_clean"
          },
          "dose": {
            "kind": "repetition",
            "sets": 4,
            "reps": {
              "min": 3,
              "max": 3
            }
          },
          "load": {
            "kind": "percent_one_rm",
            "percent": 70
          },
          "effort": {
            "kind": "rpe",
            "target": 7
          },
          "quality": {
            "kind": "technical",
            "stopRule": "crisp_bar_speed"
          },
          "rest": {
            "min": 120,
            "max": 150
          }
        }
      ]
    },
    {
      "id": "block-strength",
      "title": "Lower & Upper Strength Pairing",
      "role": "main",
      "executionMode": "alternating",
      "optionSets": [
        {
          "id": "choice-squat-warmup",
          "appliesAtStepId": "step-str-1",
          "trigger": {
            "kind": "athlete_observed",
            "description": "How did the warm-up sets feel?"
          },
          "options": [
            {
              "id": "continue-squat",
              "label": "Comfortable and controlled — continue as written",
              "actions": []
            },
            {
              "id": "reduce-squat-load",
              "label": "Heavier than expected — reduce load 10%",
              "actions": [
                {
                  "kind": "reduce_load_percent",
                  "targetStepId": "step-str-1",
                  "percent": 10
                }
              ]
            },
            {
              "id": "reduce-squat-reps",
              "label": "Still heavy — reduce to 3 reps per set",
              "actions": [
                {
                  "kind": "reduce_reps",
                  "targetStepId": "step-str-1",
                  "reps": 3
                }
              ]
            }
          ]
        },
        {
          "id": "choice-squat-symptom",
          "appliesAtStepId": "step-str-1",
          "trigger": {
            "kind": "athlete_observed",
            "description": "Any knee or back discomfort on the first working set?"
          },
          "options": [
            {
              "id": "continue-squat-symptom-free",
              "label": "No discomfort — continue as written",
              "actions": []
            },
            {
              "id": "switch-goblet-squat",
              "label": "Some discomfort — switch to Goblet Squat",
              "actions": [
                {
                  "kind": "select_alternative",
                  "targetStepId": "step-str-1",
                  "alternativeId": "alt-goblet-squat"
                }
              ]
            },
            {
              "id": "end-squat-block",
              "label": "Sharp discomfort — end the block",
              "actions": [
                {
                  "kind": "end_block",
                  "targetBlockId": "block-strength"
                }
              ]
            }
          ]
        }
      ],
      "steps": [
        {
          "kind": "exercise",
          "id": "step-str-1",
          "exerciseRef": { "kind": "catalog", "exerciseId": "back_squat" },
          "dose": {
            "kind": "repetition",
            "sets": 3,
            "reps": {
              "min": 5,
              "max": 5
            }
          },
          "load": {
            "kind": "descriptive",
            "display": "Use the last reviewed technically sound working load."
          },
          "effort": {
            "kind": "rir",
            "target": 3
          },
          "tempo": {
            "display": "3-1-X-1"
          },
          "rest": {
            "min": 120,
            "max": 180
          },
          "alternatives": [
            {
              "id": "alt-goblet-squat",
              "title": "Goblet Squat (reduced axial load)",
              "exerciseRef": { "kind": "catalog", "exerciseId": "goblet_squat" },
              "load": {
                "kind": "descriptive",
                "display": "Use a comfortable dumbbell, well short of grinding."
              }
            }
          ]
        },
        {
          "kind": "exercise",
          "id": "step-str-2",
          "exerciseRef": {
            "kind": "catalog",
            "exerciseId": "bench_press"
          },
          "dose": {
            "kind": "repetition",
            "sets": 3,
            "reps": {
              "min": 6,
              "max": 6
            }
          },
          "load": {
            "kind": "percent_one_rm",
            "percent": 75
          },
          "effort": {
            "kind": "rir",
            "target": 2
          },
          "tempo": {
            "display": "2-1-X-0"
          },
          "rest": {
            "min": 90,
            "max": 120
          }
        }
      ]
    }
  ]
}
