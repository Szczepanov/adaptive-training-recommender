          "trigger": {
            "kind": "athlete_observed",
            "description": "How do the warm-up and speed off the floor feel?"
          },
          "options": [
            {
              "id": "continue-floor-clean",
              "label": "Crisp — continue as written",
              "actions": []
            },
            {
              "id": "reduce-floor-clean-load",
              "label": "Heavy or slow — reduce load 5%",
              "actions": [
                {
                  "kind": "reduce_load_percent",
                  "targetStepId": "step-clean-main",
                  "percent": 5
                }
              ]
            },
            {
              "id": "end-floor-clean-block",
              "label": "Catch or joint comfort is poor — end the block",
              "actions": [
                {
                  "kind": "end_block",
                  "targetBlockId": "block-main-clean"
                }
              ]
            }
          ]
        }
      ],
      "steps": [
        {
          "kind": "exercise",
          "id": "step-clean-main",
          "exerciseRef": {
            "kind": "unresolved_free_text",
            "name": "Power Clean (from the floor)"
          },
          "dose": {
            "kind": "repetition",
            "sets": 5,
            "reps": {
              "min": 2,
              "max": 2
            }
          },
          "load": {
            "kind": "descriptive",
