      "steps": [
        {
          "kind": "exercise",
          "id": "step-clean-warmup",
          "exerciseRef": {
            "kind": "catalog",
            "exerciseId": "hang_power_clean"
          },
          "dose": {
            "kind": "repetition",
            "sets": 3,
            "reps": {
              "min": 3,
              "max": 3
            }
          },
          "load": {
            "kind": "percent_one_rm",
            "percent": 50
          },
          "rest": {
            "min": 60,
            "max": 90
          }
        }
      ]
    },
    {
      "id": "block-main-clean",
