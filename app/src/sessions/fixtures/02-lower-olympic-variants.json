          },
          "effort": {
            "kind": "rpe",
            "target": 7.5
          },
          "quality": {
            "kind": "velocity_loss",
            "maxLossPercent": 10
          },
          "rest": {
            "min": 120,
            "max": 180
          },
          "resolutionNote": "Not in the catalog. Loggable by name; asserts no safety, cost, stimulus, muscle-split, PR or 1RM semantics (ADR-0023 D-MSESSION; plan M3.5 adds it)."
