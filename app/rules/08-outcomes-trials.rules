
    // --- PR 1 (ADR-0034): canonical performed-training-occurrence shadow reconciliation.
    // Written by the client SDK (shadow-mode reconciliation runs in-browser -- see
    // training-occurrence/reconciliationService.ts), so this needs real schema validation
    // rather than an Admin-SDK-only `allow write: if false` block. Rules cannot iterate an
    // arbitrary-length list<map>, so `sourceRefs` element validation is bounded to the
    // first 4 entries (mirrors `hasValidAdditionalSessions` above) -- full structural
    // correctness for any list this rule can't fully cover is enforced by
    // `training-occurrence/validation.ts` plus its unit/emulator tests, not by rules
    // alone.
    function hasValidPerformedOccurrenceSourceRef(ref) {
      return ref is map && (
        (ref.kind == 'structured_execution'
          && ref.keys().hasOnly(['kind', 'executionId', 'sessionOccurrenceId', 'prescriptionHash', 'fitWorkoutFingerprint', 'fitWorkoutFingerprintKind'])
          && ref.keys().hasAll(['kind', 'executionId'])
          && ref.executionId is string
          && (!('sessionOccurrenceId' in ref) || ref.sessionOccurrenceId is string)
          && (!('prescriptionHash' in ref) || ref.prescriptionHash is string)
          && (('fitWorkoutFingerprint' in ref) == ('fitWorkoutFingerprintKind' in ref))
          && (!('fitWorkoutFingerprint' in ref) || (ref.fitWorkoutFingerprint is string && ref.fitWorkoutFingerprint.matches('^fit-workout-v2:[0-9a-f]{32}$')))
          && (!('fitWorkoutFingerprintKind' in ref) || ref.fitWorkoutFingerprintKind in ['semantic_definition', 'index_fallback']))
        || (ref.kind == 'provider_activity'
          && ref.keys().hasOnly(['kind', 'provider', 'activityId', 'deviceId', 'fitWorkoutFingerprint', 'fitWorkoutFingerprintKind'])
          && ref.keys().hasAll(['kind', 'provider', 'activityId'])
          && ref.provider is string
          && ref.activityId is string
          && (!('deviceId' in ref) || ref.deviceId is string)
          && (('fitWorkoutFingerprint' in ref) == ('fitWorkoutFingerprintKind' in ref))
          && (!('fitWorkoutFingerprint' in ref) || (ref.fitWorkoutFingerprint is string && ref.fitWorkoutFingerprint.matches('^fit-workout-v2:[0-9a-f]{32}$')))
          && (!('fitWorkoutFingerprintKind' in ref) || ref.fitWorkoutFingerprintKind in ['semantic_definition', 'index_fallback']))
      );
    }

    function hasValidReconciliationManualDecision(decision) {
      return decision is map
        && decision.decision in ['link', 'unlink', 'keep_separate']
        && decision.actor is string
        && decision.decidedAt is string;
    }

    function hasValidReconciliation(reconciliation) {
      return reconciliation is map
        && reconciliation.state in ['single_source', 'matched', 'ambiguous']
        && (!('confidence' in reconciliation) || (reconciliation.confidence is number && reconciliation.confidence >= 0 && reconciliation.confidence <= 1))
        && (!('manualDecision' in reconciliation) || hasValidReconciliationManualDecision(reconciliation.manualDecision))
        && (!('excludedSourceKeys' in reconciliation) || (reconciliation.excludedSourceKeys is list && reconciliation.excludedSourceKeys.size() <= 16));
    }

    function hasValidPerformedTrainingOccurrence(userId, occurrenceId) {
      let data = request.resource.data;
      return hasOwnedUserId(userId)
        && data.performedOccurrenceId == occurrenceId
        && data.keys().hasOnly(['schemaVersion', 'performedOccurrenceId', 'userId', 'status', 'mergedIntoOccurrenceId', 'startedAt', 'endedAt', 'localDate', 'modality', 'sourceRefs', 'reconciliation', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['schemaVersion', 'performedOccurrenceId', 'userId', 'status', 'sourceRefs', 'reconciliation', 'createdAt', 'updatedAt'])
        && data.schemaVersion == 1
        && data.status in ['active', 'merged']
        && (!('mergedIntoOccurrenceId' in data) || data.mergedIntoOccurrenceId is string)
        && (!('startedAt' in data) || data.startedAt is string)
        && (!('endedAt' in data) || data.endedAt is string)
        && (!('localDate' in data) || isValidActivityDate(data.localDate))
        && (!('modality' in data) || data.modality is string)
        && data.sourceRefs is list && data.sourceRefs.size() >= 1 && data.sourceRefs.size() <= 4
        && (data.sourceRefs.size() < 1 || hasValidPerformedOccurrenceSourceRef(data.sourceRefs[0]))
        && (data.sourceRefs.size() < 2 || hasValidPerformedOccurrenceSourceRef(data.sourceRefs[1]))
        && (data.sourceRefs.size() < 3 || hasValidPerformedOccurrenceSourceRef(data.sourceRefs[2]))
        && (data.sourceRefs.size() < 4 || hasValidPerformedOccurrenceSourceRef(data.sourceRefs[3]))
        && hasValidReconciliation(data.reconciliation)
        && data.createdAt is string
        && data.updatedAt is string;
    }

    match /users/{userId}/performedTrainingOccurrences/{occurrenceId} {
      allow read: if isOwner(userId);
      allow create: if hasValidPerformedTrainingOccurrence(userId, occurrenceId);
      allow update: if hasValidPerformedTrainingOccurrence(userId, occurrenceId)
        && keepsOwnership(userId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.schemaVersion == resource.data.schemaVersion;
      // Tombstoning is via `status: 'merged'`, never delete (ADR-0034 "not destructive").
      allow delete: if false;
    }

    // `sourceLinkId` (the doc ID) is a normalized/possibly-hashed encoding of `sourceKey`
    // (`training-occurrence/sourceIdentity.ts#encodeSourceKeyForDocId`) -- rules cannot
    // re-derive that encoding, so identity integrity relies on the app always deriving the
    // doc ID deterministically, not on a rules-level equality check here.
    function hasValidPerformedOccurrenceSourceLink(userId) {
      let data = request.resource.data;
      return hasOwnedUserId(userId)
        && data.keys().hasOnly(['schemaVersion', 'sourceKey', 'sourceKind', 'userId', 'performedOccurrenceId', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['schemaVersion', 'sourceKey', 'sourceKind', 'userId', 'performedOccurrenceId', 'createdAt', 'updatedAt'])
        && data.schemaVersion == 1
        && data.sourceKey is string && data.sourceKey.size() > 0
        && data.sourceKind in ['structured_execution', 'provider_activity']
        && data.performedOccurrenceId is string && data.performedOccurrenceId.size() > 0
        && data.createdAt is string
        && data.updatedAt is string;
    }

    match /users/{userId}/performedOccurrenceSourceLinks/{sourceLinkId} {
      allow read: if isOwner(userId);
      allow create: if hasValidPerformedOccurrenceSourceLink(userId);
      // Only `performedOccurrenceId` may change on update -- the merge/unlink repair
      // paths re-point a link to a survivor/new occurrence; `sourceKey`/`sourceKind`
      // identity is otherwise immutable.
      allow update: if hasValidPerformedOccurrenceSourceLink(userId)
        && keepsOwnership(userId)
        && request.resource.data.sourceKey == resource.data.sourceKey
        && request.resource.data.sourceKind == resource.data.sourceKind
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    function hasValidSessionResponse(userId, responseId) {
      let data = request.resource.data;
      return hasOwnedUserId(userId)
        && data.keys().hasOnly(['userId', 'responseId', 'sourceSession', 'occurrenceId', 'window', 'date', 'checkinRef', 'sessionRpe', 'completedFraction', 'unexpectedFatigue', 'techniqueNote', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['userId', 'responseId', 'sourceSession', 'window', 'date', 'checkinRef', 'createdAt', 'updatedAt'])
        && data.responseId == responseId
        && data.sourceSession is map
        && data.sourceSession.keys().hasOnly(['kind', 'id', 'date'])
        && data.sourceSession.keys().hasAll(['kind', 'id', 'date'])
        && data.sourceSession.kind in ['strength', 'execution']
        && data.sourceSession.id is string && data.sourceSession.id.size() > 0
        && isValidActivityDate(data.sourceSession.date)
        && data.window in ['immediate', 'later_day', 'next_morning']
        && isValidActivityDate(data.date)
        && ((data.window == 'immediate' && data.date == data.sourceSession.date)
          || (data.window == 'later_day' && data.date == data.sourceSession.date)
          || (data.window == 'next_morning' && data.date > data.sourceSession.date))
        && data.checkinRef is map
        && data.checkinRef.keys().hasOnly(['date'])
        && isValidActivityDate(data.checkinRef.date)
        && (!('occurrenceId' in data) || (
          data.occurrenceId is string && data.occurrenceId.size() > 0
          && exists(/databases/$(database)/documents/users/$(userId)/session_occurrences/$(data.occurrenceId))
        ))
        && (!('sessionRpe' in data) || (data.sessionRpe is number && data.sessionRpe >= 0 && data.sessionRpe <= 10))
        && (!('completedFraction' in data) || (data.completedFraction is number && data.completedFraction >= 0 && data.completedFraction <= 1))
        && (!('unexpectedFatigue' in data) || data.unexpectedFatigue is bool)
        && (!('techniqueNote' in data) || (data.techniqueNote is string && data.techniqueNote.size() <= 2000))
        && (!('note' in data) || (data.note is string && data.note.size() <= 2000))
        && data.createdAt is string && data.updatedAt is string;
    }

    match /users/{userId}/session_responses/{responseId} {
      allow read: if isOwner(userId);
      allow create: if hasValidSessionResponse(userId, responseId);
      allow update: if hasValidSessionResponse(userId, responseId)
        && keepsOwnership(userId)
        && request.resource.data.sourceSession == resource.data.sourceSession
        && ('occurrenceId' in request.resource.data) == ('occurrenceId' in resource.data)
        && (!('occurrenceId' in resource.data) || request.resource.data.occurrenceId == resource.data.occurrenceId)
        && request.resource.data.window == resource.data.window
        && request.resource.data.date == resource.data.date
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
    }

    // Single rules-side source for the OV metric registry (app/src/observations/registry.ts).
    // Metric ids and units must stay in lockstep with it; firestoreRulesParity.test.ts
    // compares the two so application validation and persistence cannot drift again.
    function outcomeMetricUnits() {
      return {
        'cycling_tt_20m_mean_power_w': 'W',
        'cycling_tt_4m_mean_power_w': 'W',
        'cycling_submax_mean_hr_bpm': 'bpm',
        'cycling_submax_rpe': 'rpe',
        'strength_1rm_kg': 'kg',
        'sprint_elapsed_time_s': 's',
        'cycling_5s_peak_power_w': 'W',
        'standing_broad_jump_distance_cm': 'cm',
        'wall_touch_cmj_height_cm': 'cm',
        'seated_medball_throw_distance_m': 'm',
        'cycling_sprint_1s_peak_power_w': 'W',
        'cycling_sprint_5s_mean_power_w': 'W'
      };
    }

    // Mirrors ComparisonDimension / protocols.ts DIMENSIONS; checked by firestoreRulesParity.test.ts.
    function comparisonDimensionIds() {
      return ['power_source_id', 'bike_setup_id', 'test_environment', 'course_or_trainer_id', 'duration_seconds', 'start_mode', 'warmup_revision', 'feedback_rule', 'weather_note', 'timing_method', 'measurement_method_id', 'equipment_setup_id'];
    }

    function hasKnownOutcomeMetric(metricId) {
      return metricId is string && metricId in outcomeMetricUnits();
    }

    function hasValidOutcomeMetricUnit(metricId, unit) {
      return hasKnownOutcomeMetric(metricId) && unit == outcomeMetricUnits()[metricId];
    }

    // ADR-0046 D-AT-PROTOCOL: the bounded multi-trial capture contract persisted on the
    // immutable protocol revision. Field/reducer semantics are validated by
    // assessmentCapture.ts; the rules bound shape, sizes and the replayable reducer version.
    function hasValidAssessmentCapture(capture) {
      return capture is map
        && capture.keys().hasOnly(['plannedTrials', 'maxTrials', 'fields', 'reducers', 'reducerVersion'])
        && capture.keys().hasAll(['plannedTrials', 'maxTrials', 'fields', 'reducers', 'reducerVersion'])
        && capture.maxTrials is int && capture.maxTrials >= 1 && capture.maxTrials <= 30
        && capture.plannedTrials is int && capture.plannedTrials >= 1 && capture.plannedTrials <= capture.maxTrials
        && capture.fields is list && capture.fields.size() >= 1 && capture.fields.size() <= 16
        && capture.reducers is list && capture.reducers.size() >= 1 && capture.reducers.size() <= 8
        && capture.reducerVersion == 'assessment-reducer-v1';
    }

    function hasValidProtocolRef(userId, protocolRef) {
      let protocolPath = /databases/$(database)/documents/users/$(userId)/measurement_protocols/$(protocolRef.id)/revisions/$(string(protocolRef.revision));
      return protocolRef is map
        && protocolRef.keys().hasOnly(['id', 'revision'])
        && protocolRef.keys().hasAll(['id', 'revision'])
        && protocolRef.id is string && protocolRef.id.size() > 0 && protocolRef.id.size() <= 128
        && protocolRef.revision is int && protocolRef.revision >= 1
        && exists(protocolPath);
    }

    function hasValidMeasurementProtocol(userId, protocolId, revisionId) {
      let data = request.resource.data;
      let comparison = data.comparisonContext;
      let familiarization = data.familiarization;
      let dimensions = comparisonDimensionIds();
      return isOwner(userId)
        && data.keys().hasOnly(['id', 'revision', 'title', 'intent', 'metricIds', 'instructions', 'warmupRef', 'comparisonContext', 'familiarization', 'burden', 'expectedRecoveryHours', 'invalidationRules', 'capture', 'createdAt'])
        && data.keys().hasAll(['id', 'revision', 'title', 'intent', 'metricIds', 'instructions', 'comparisonContext', 'familiarization', 'burden', 'invalidationRules', 'createdAt'])
        && data.id == protocolId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.revision is int && data.revision >= 1 && string(data.revision) == revisionId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.intent == 'testing'
        && data.metricIds is list && data.metricIds.size() >= 1 && data.metricIds.size() <= 8
        && data.metricIds.hasOnly(outcomeMetricUnits().keys())
        && data.instructions is list && data.instructions.size() <= 64
        && (!('warmupRef' in data) || (data.warmupRef is string && data.warmupRef.size() > 0 && data.warmupRef.size() <= 128))
        && comparison is map
        && comparison.keys().hasOnly(['required', 'seriesDefining', 'contextOnly', 'canonicalizationVersion'])
        && comparison.keys().hasAll(['required', 'seriesDefining', 'contextOnly', 'canonicalizationVersion'])
        && comparison.required is list && comparison.required.size() <= 16 && comparison.required.hasOnly(dimensions)
        && comparison.seriesDefining is list && comparison.seriesDefining.size() <= 16 && comparison.seriesDefining.hasOnly(comparison.required)
        && comparison.contextOnly is list && comparison.contextOnly.size() <= 16 && comparison.contextOnly.hasOnly(comparison.required)
        && !comparison.seriesDefining.hasAny(comparison.contextOnly)
        && comparison.required.size() <= comparison.seriesDefining.size() + comparison.contextOnly.size()
        && comparison.canonicalizationVersion is string && comparison.canonicalizationVersion.size() > 0 && comparison.canonicalizationVersion.size() <= 64
        && familiarization is map
        && familiarization.keys().hasOnly(['required', 'minimumExposures'])
        && familiarization.keys().hasAll(['required', 'minimumExposures'])
        && familiarization.required is bool
        && familiarization.minimumExposures is int && familiarization.minimumExposures >= 0 && familiarization.minimumExposures <= 20
        && (!familiarization.required || familiarization.minimumExposures >= 1)
        && data.burden in ['low', 'moderate', 'high']
        && (!('expectedRecoveryHours' in data) || (data.expectedRecoveryHours is number && data.expectedRecoveryHours >= 0 && data.expectedRecoveryHours <= 336))
        && data.invalidationRules is list && data.invalidationRules.size() <= 32
        && (!('capture' in data) || hasValidAssessmentCapture(data.capture))
        && data.createdAt is string && data.createdAt.size() > 0;
    }

    match /users/{userId}/measurement_protocols/{protocolId}/revisions/{revisionId} {
      allow read: if isOwner(userId);
      allow create: if hasValidMeasurementProtocol(userId, protocolId, revisionId);
      allow update, delete: if false;
    }

    function hasValidAssessmentAttempt(userId, attemptId) {
      let data = request.resource.data;
      return isOwner(userId)
        && data.keys().hasOnly(['id', 'protocolRef', 'scheduledDate', 'startedAt', 'completedAt', 'state', 'purpose', 'sourceSessionRef', 'notes'])
        && data.keys().hasAll(['id', 'protocolRef', 'state', 'purpose'])
        && data.id == attemptId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 160
        && hasValidProtocolRef(userId, data.protocolRef)
        && data.state in ['scheduled', 'in_progress', 'completed', 'abandoned']
        && data.purpose in ['familiarization', 'baseline', 'checkpoint', 'post_block']
        && (!('scheduledDate' in data) || isValidActivityDate(data.scheduledDate))
        && (!('startedAt' in data) || (data.startedAt is string && data.startedAt.size() > 0))
        && (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() > 0))
        && (!('sourceSessionRef' in data) || (data.sourceSessionRef is string && data.sourceSessionRef.size() > 0 && data.sourceSessionRef.size() <= 256))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000))
        && (data.state != 'scheduled' || (!('startedAt' in data) && !('completedAt' in data)))
        && (data.state != 'in_progress' || (('startedAt' in data) && !('completedAt' in data)))
        && (data.state != 'completed' || (('startedAt' in data) && ('completedAt' in data)))
        && (data.state != 'abandoned' || !('completedAt' in data));
    }

    function hasValidAssessmentAttemptTransition() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.protocolRef == resource.data.protocolRef
        && request.resource.data.purpose == resource.data.purpose
        && (('scheduledDate' in request.resource.data) == ('scheduledDate' in resource.data))
        && (!('scheduledDate' in resource.data) || request.resource.data.scheduledDate == resource.data.scheduledDate)
        && (!('startedAt' in resource.data) || request.resource.data.startedAt == resource.data.startedAt)
        && (!('completedAt' in resource.data) || request.resource.data.completedAt == resource.data.completedAt)
        && (
          request.resource.data.state == resource.data.state
          || (resource.data.state == 'scheduled' && request.resource.data.state in ['in_progress', 'abandoned'])
          || (resource.data.state == 'in_progress' && request.resource.data.state in ['completed', 'abandoned'])
        );
    }

    match /users/{userId}/assessment_attempts/{attemptId} {
      allow read: if isOwner(userId);
      allow create: if hasValidAssessmentAttempt(userId, attemptId);
      allow update: if hasValidAssessmentAttempt(userId, attemptId)
        && hasValidAssessmentAttemptTransition();
      allow delete: if false;
    }

    function observationHeadAfterRevision(userId, observationKey, revision) {
      let headPath = /databases/$(database)/documents/users/$(userId)/metric_observations/$(observationKey);
      let head = getAfter(headPath).data;
      return head.observationKey == observationKey && head.headRevision == revision;
    }

    function revisionAfterHead(userId, observationKey, revision) {
      let revisionPath = /databases/$(database)/documents/users/$(userId)/metric_observations/$(observationKey)/revisions/$(string(revision));
      let next = getAfter(revisionPath).data;
      return next.observationKey == observationKey && next.revision == revision;
    }

    function hasValidObservationHead(userId, observationKey) {
      let data = request.resource.data;
      return isOwner(userId)
        && data.keys().hasOnly(['observationKey', 'assessmentAttemptId', 'metricId', 'headRevision', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['observationKey', 'assessmentAttemptId', 'metricId', 'headRevision', 'createdAt', 'updatedAt'])
        && data.observationKey == observationKey
        && data.assessmentAttemptId is string && data.assessmentAttemptId.size() > 0 && data.assessmentAttemptId.size() <= 160
        && hasKnownOutcomeMetric(data.metricId)
        && data.observationKey == data.assessmentAttemptId + ':' + data.metricId
        && data.headRevision is int && data.headRevision >= 1
        && data.createdAt is string && data.createdAt.size() > 0
        && data.updatedAt is string && data.updatedAt.size() > 0;
    }

    function hasValidObservationDevice(device) {
      return device is map
        && device.keys().hasOnly(['provider', 'model', 'deviceId'])
        && device.keys().hasAll(['provider'])
        && device.provider is string && device.provider.size() > 0 && device.provider.size() <= 128
        && (!('model' in device) || (device.model is string && device.model.size() > 0 && device.model.size() <= 128))
        && (!('deviceId' in device) || (device.deviceId is string && device.deviceId.size() > 0 && device.deviceId.size() <= 256));
    }

    function hasValidObservationProtocolBinding(userId, data) {
      let protocolPath = /databases/$(database)/documents/users/$(userId)/measurement_protocols/$(data.protocolRef.id)/revisions/$(string(data.protocolRef.revision));
      let attemptPath = /databases/$(database)/documents/users/$(userId)/assessment_attempts/$(data.assessmentAttemptId);
      return hasValidProtocolRef(userId, data.protocolRef)
        && exists(attemptPath)
        && get(attemptPath).data.protocolRef == data.protocolRef
        && get(protocolPath).data.metricIds.hasAny([data.metricId])
        && get(protocolPath).data.comparisonContext.canonicalizationVersion == data.comparisonCanonicalizationVersion
        && hasValidTrialCaptureBinding(data, get(protocolPath).data, get(attemptPath).data);
    }

    // ADR-0046 D-AT-REDUCE / D-AT-CORRECTION: a trial-capture protocol's canonical values are
    // reducer outputs, never hand-typed summaries. They must be derived from typed trial
    // evidence under the protocol's own reducer version, and never from an abandoned (or
    // not-yet-started) attempt. Summary-only protocols are unaffected.
    function hasValidTrialCaptureBinding(data, protocol, attempt) {
      return !('capture' in protocol)
        || (data.source == 'derived'
          && ('derivedFromEvidenceRefs' in data)
          && data.algorithmVersion == protocol.capture.reducerVersion
          && attempt.state in ['in_progress', 'completed']);
    }

    function hasValidMetricObservationRevision(userId, observationKey, revisionId) {
      let data = request.resource.data;
      return isOwner(userId)
        && data.keys().hasOnly(['observationKey', 'revision', 'supersedesRevision', 'metricId', 'value', 'unit', 'observedAt', 'source', 'sourceRef', 'device', 'protocolRef', 'comparisonSeriesKey', 'comparisonCanonicalizationVersion', 'assessmentAttemptId', 'validity', 'invalidReason', 'context', 'derivedFromObservationIds', 'derivedFromEvidenceRefs', 'algorithmVersion', 'correctionReason', 'createdAt'])
        && data.keys().hasAll(['observationKey', 'revision', 'metricId', 'value', 'unit', 'observedAt', 'source', 'protocolRef', 'comparisonSeriesKey', 'comparisonCanonicalizationVersion', 'assessmentAttemptId', 'validity', 'context', 'createdAt'])
        && data.observationKey == observationKey
        && data.assessmentAttemptId is string && data.assessmentAttemptId.size() > 0 && data.assessmentAttemptId.size() <= 160
        && data.observationKey == data.assessmentAttemptId + ':' + data.metricId
        && data.revision is int && data.revision >= 1 && string(data.revision) == revisionId
        && ((data.revision == 1 && !('supersedesRevision' in data) && !('correctionReason' in data))
          || (data.revision > 1
            && data.supersedesRevision is int && data.supersedesRevision == data.revision - 1
            && data.correctionReason is string && data.correctionReason.size() > 0 && data.correctionReason.size() <= 2000))
        && hasKnownOutcomeMetric(data.metricId)
        && data.value is number
        && hasValidOutcomeMetricUnit(data.metricId, data.unit)
        && data.observedAt is string && data.observedAt.size() > 0
        && data.source in ['manual', 'garmin_activity', 'garmin_lap', 'derived']
        && (!('sourceRef' in data) || (data.sourceRef is string && data.sourceRef.size() > 0 && data.sourceRef.size() <= 512))
        && (!('device' in data) || hasValidObservationDevice(data.device))
        && data.comparisonSeriesKey is string && data.comparisonSeriesKey.size() > 0 && data.comparisonSeriesKey.size() <= 128
        && data.comparisonCanonicalizationVersion is string && data.comparisonCanonicalizationVersion.size() > 0 && data.comparisonCanonicalizationVersion.size() <= 64
        && data.validity in ['valid', 'invalid', 'practice', 'questionable']
        && (data.validity != 'invalid' || ('invalidReason' in data))
        && (!('invalidReason' in data) || (data.invalidReason is string && data.invalidReason.size() > 0 && data.invalidReason.size() <= 2000))
        && data.context is map && data.context.size() <= 64
        && hasValidDerivationProvenance(data)
        && data.createdAt is string && data.createdAt.size() > 0
        && hasValidObservationProtocolBinding(userId, data);
    }

    // ADR-0046 D-AT-REDUCE: a derived revision names its sources as observation IDs
    // (observation-to-observation derivation), typed trial evidence references (trial-only
    // derivation) or both. Non-derived revisions carry neither. Per-reference shape and
    // same-attempt binding are validated fail-closed by validation.ts before any write.
    function hasValidDerivationProvenance(data) {
      return (data.source == 'derived'
          && (('derivedFromObservationIds' in data) || ('derivedFromEvidenceRefs' in data))
          && (!('derivedFromObservationIds' in data) || (data.derivedFromObservationIds is list && data.derivedFromObservationIds.size() >= 1 && data.derivedFromObservationIds.size() <= 32))
          && (!('derivedFromEvidenceRefs' in data) || (data.derivedFromEvidenceRefs is list && data.derivedFromEvidenceRefs.size() >= 1 && data.derivedFromEvidenceRefs.size() <= 32))
          && ('algorithmVersion' in data) && data.algorithmVersion is string && data.algorithmVersion.size() > 0 && data.algorithmVersion.size() <= 128)
        || (data.source != 'derived'
          && !('derivedFromObservationIds' in data)
          && !('derivedFromEvidenceRefs' in data)
          && !('algorithmVersion' in data));
    }

    match /users/{userId}/metric_observations/{observationKey} {
      allow read: if isOwner(userId);
      allow create: if hasValidObservationHead(userId, observationKey)
        && request.resource.data.headRevision == 1
        && revisionAfterHead(userId, observationKey, 1);
      allow update: if hasValidObservationHead(userId, observationKey)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['headRevision', 'updatedAt'])
        && request.resource.data.headRevision == resource.data.headRevision + 1
        && revisionAfterHead(userId, observationKey, request.resource.data.headRevision);
      allow delete: if false;

      match /revisions/{revisionId} {
        allow read: if isOwner(userId);
        allow create: if hasValidMetricObservationRevision(userId, observationKey, revisionId)
          && observationHeadAfterRevision(userId, observationKey, request.resource.data.revision)
          && (
            (request.resource.data.revision == 1 && !exists(/databases/$(database)/documents/users/$(userId)/metric_observations/$(observationKey)))
            || (request.resource.data.revision > 1
              && get(/databases/$(database)/documents/users/$(userId)/metric_observations/$(observationKey)).data.headRevision == request.resource.data.supersedesRevision)
          );
        allow update, delete: if false;
      }
    }

    function assessmentTrialIdFor(ordinal, correctionIndex) {
      return correctionIndex == 0
        ? 'trial-' + string(ordinal)
        : 'trial-' + string(ordinal) + '-c' + string(correctionIndex);
    }

    // ADR-0046 D-AT-TRIAL / D-AT-CORRECTION: immutable raw trials below an assessment attempt.
    // The id is a pure function of (ordinal, correctionIndex), so concurrent corrections of one
    // ordinal collide on one immutable document instead of forking. New ordinals are admitted
    // only while the attempt is in progress; a completed attempt admits supersessions only;
    // scheduled/abandoned attempts admit nothing. Field-level conformance to the protocol
    // capture schema is enforced by assessmentTrials.ts before any write.
    function hasValidAssessmentTrial(userId, attemptId, trialId) {
      let data = request.resource.data;
      let attemptPath = /databases/$(database)/documents/users/$(userId)/assessment_attempts/$(attemptId);
      let attempt = get(attemptPath).data;
      let protocolPath = /databases/$(database)/documents/users/$(userId)/measurement_protocols/$(attempt.protocolRef.id)/revisions/$(string(attempt.protocolRef.revision));
      return isOwner(userId)
        && data.keys().hasOnly(['id', 'assessmentAttemptId', 'ordinal', 'correctionIndex', 'supersedesTrialId', 'correctionReason', 'performedAt', 'validity', 'invalidReason', 'values', 'context', 'sourceRef', 'device', 'notes', 'createdAt'])
        && data.keys().hasAll(['id', 'assessmentAttemptId', 'ordinal', 'correctionIndex', 'validity', 'values', 'context', 'createdAt'])
        && data.id == trialId
        && data.assessmentAttemptId == attemptId
        && data.ordinal is int && data.ordinal >= 1
        && data.correctionIndex is int && data.correctionIndex >= 0 && data.correctionIndex <= 20
        && data.id == assessmentTrialIdFor(data.ordinal, data.correctionIndex)
        && exists(attemptPath)
        && (attempt.state == 'in_progress' || (attempt.state == 'completed' && data.correctionIndex > 0))
        && exists(protocolPath)
        && ('capture' in get(protocolPath).data)
        && data.ordinal <= get(protocolPath).data.capture.maxTrials
        && ((data.correctionIndex == 0 && !('supersedesTrialId' in data) && !('correctionReason' in data))
          || (data.correctionIndex > 0
            && data.supersedesTrialId == assessmentTrialIdFor(data.ordinal, data.correctionIndex - 1)
            && existsAfter(/databases/$(database)/documents/users/$(userId)/assessment_attempts/$(attemptId)/trials/$(data.supersedesTrialId))
            && data.correctionReason is string && data.correctionReason.size() > 0 && data.correctionReason.size() <= 2000))
        && data.validity in ['valid', 'invalid', 'practice', 'questionable']
        && (data.validity != 'invalid' || ('invalidReason' in data))
        && (!('invalidReason' in data) || (data.invalidReason is string && data.invalidReason.size() > 0 && data.invalidReason.size() <= 2000))
        && (!('performedAt' in data) || (data.performedAt is string && data.performedAt.size() > 0 && data.performedAt.size() <= 64))
        && data.values is map && data.values.size() <= 16
        && data.context is map && data.context.size() <= 32
        && (!('sourceRef' in data) || (data.sourceRef is string && data.sourceRef.size() > 0 && data.sourceRef.size() <= 512))
        && (!('device' in data) || hasValidObservationDevice(data.device))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000))
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    match /users/{userId}/assessment_attempts/{attemptId}/trials/{trialId} {
      allow read: if isOwner(userId);
      allow create: if hasValidAssessmentTrial(userId, attemptId, trialId);
      allow update, delete: if false;
    }

    // --- OV5.1: immutable outcome-evaluation criteria and lifecycle.
    function outcomeEvaluationHeadAfterRevision(userId, evaluationId, revision) {
      let headPath = /databases/$(database)/documents/users/$(userId)/outcome_evaluations/$(evaluationId);
      let head = getAfter(headPath).data;
      return head.id == evaluationId && head.currentRevision == revision;
    }

    function outcomeEvaluationRevisionAfterHead(userId, evaluationId, revision) {
      let revisionPath = /databases/$(database)/documents/users/$(userId)/outcome_evaluations/$(evaluationId)/revisions/$(string(revision));
      let next = getAfter(revisionPath).data;
      return next.id == evaluationId && next.revision == revision && next.status == 'draft';
    }

    function isHeadOutcomeEvaluationRevision(userId, evaluationId, revision) {
      let headPath = /databases/$(database)/documents/users/$(userId)/outcome_evaluations/$(evaluationId);
      return exists(headPath) && get(headPath).data.currentRevision == revision;
    }

    function hasValidOutcomeEvaluationHead(userId, evaluationId) {
      let data = request.resource.data;
      return isOwner(userId)
        && data.keys().hasOnly(['id', 'currentRevision', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['id', 'currentRevision', 'createdAt', 'updatedAt'])
        && data.id == evaluationId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 160
        && data.currentRevision is int && data.currentRevision >= 1
        && data.createdAt is string && data.createdAt.size() > 0
        && data.updatedAt is string && data.updatedAt.size() > 0;
    }

    function hasValidOutcomeEvaluationSourceRef(sourceRef) {
      return sourceRef is map
        && sourceRef.keys().hasOnly(['kind', 'id'])
        && sourceRef.keys().hasAll(['kind', 'id'])
        && sourceRef.kind in ['event', 'authored_plan', 'manual_block']
        && sourceRef.id is string && sourceRef.id.size() > 0 && sourceRef.id.size() <= 256;
    }

    function hasValidOutcomeEvaluationRevision(userId, evaluationId, revisionId) {
      let data = request.resource.data;
      return isOwner(userId)
        && data.keys().hasOnly(['id', 'revision', 'title', 'startDate', 'endDate', 'sourceRef', 'status', 'activatedAt', 'contentHash', 'createdAt', 'bindings'])
        && data.keys().hasAll(['id', 'revision', 'title', 'startDate', 'endDate', 'status', 'contentHash', 'createdAt', 'bindings'])
        && data.id == evaluationId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 160
        && data.revision is int && data.revision >= 1 && string(data.revision) == revisionId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && isValidActivityDate(data.startDate)
        && isValidActivityDate(data.endDate)
        && data.startDate <= data.endDate
        && (!('sourceRef' in data) || hasValidOutcomeEvaluationSourceRef(data.sourceRef))
        && data.status in ['draft', 'active', 'completed', 'archived']
        && data.bindings is list && data.bindings.size() >= 1 && data.bindings.size() <= 16
        && data.createdAt is string && data.createdAt.size() > 0
        && (
          (data.status == 'draft'
            && !('activatedAt' in data)
            && data.contentHash == '')
          || (data.status != 'draft'
            && data.activatedAt is string && data.activatedAt.size() > 0
            && data.contentHash is string
            && data.contentHash.matches('^[0-9a-f]{64}$'))
        );
    }

    function hasValidCompetitionOutcomeEvaluationRef(userId, evaluationRef) {
      let revisionPath = /databases/$(database)/documents/users/$(userId)/outcome_evaluations/$(evaluationRef.id)/revisions/$(string(evaluationRef.revision));
      return evaluationRef is map
        && evaluationRef.keys().hasOnly(['id', 'revision', 'contentHash'])
        && evaluationRef.keys().hasAll(['id', 'revision', 'contentHash'])
        && evaluationRef.id is string && evaluationRef.id.size() > 0 && evaluationRef.id.size() <= 160
        && evaluationRef.revision is int && evaluationRef.revision >= 1
        && evaluationRef.contentHash is string && evaluationRef.contentHash.matches('^[0-9a-f]{64}$')
        && exists(revisionPath)
        && get(revisionPath).data.status in ['active', 'completed', 'archived']
        && get(revisionPath).data.contentHash == evaluationRef.contentHash;
    }

    function competitionOutcomeEventMatchesEvaluation(userId, evaluationRef, eventRef) {
      let revisionPath = /databases/$(database)/documents/users/$(userId)/outcome_evaluations/$(evaluationRef.id)/revisions/$(string(evaluationRef.revision));
      let evaluation = get(revisionPath).data;
      return !('sourceRef' in evaluation)
        || evaluation.sourceRef.kind != 'event'
        || (eventRef is string && eventRef.size() > 0 && evaluation.sourceRef.id == eventRef);
    }

    match /users/{userId}/outcome_evaluations/{evaluationId} {
      allow read: if isOwner(userId);
      allow create: if hasValidOutcomeEvaluationHead(userId, evaluationId)
        && request.resource.data.currentRevision == 1
        && outcomeEvaluationRevisionAfterHead(userId, evaluationId, 1);
      allow update: if hasValidOutcomeEvaluationHead(userId, evaluationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentRevision', 'updatedAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.currentRevision == resource.data.currentRevision + 1
        && outcomeEvaluationRevisionAfterHead(userId, evaluationId, request.resource.data.currentRevision);
      allow delete: if false;

      match /revisions/{revisionId} {
        allow read: if isOwner(userId);
        allow create: if hasValidOutcomeEvaluationRevision(userId, evaluationId, revisionId)
          && request.resource.data.status == 'draft'
          && outcomeEvaluationHeadAfterRevision(userId, evaluationId, request.resource.data.revision)
          && (
            (request.resource.data.revision == 1
              && !exists(/databases/$(database)/documents/users/$(userId)/outcome_evaluations/$(evaluationId)))
            || (request.resource.data.revision > 1
              && get(/databases/$(database)/documents/users/$(userId)/outcome_evaluations/$(evaluationId)).data.currentRevision == request.resource.data.revision - 1)
          );
        allow update: if hasValidOutcomeEvaluationRevision(userId, evaluationId, revisionId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.revision == resource.data.revision
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            (resource.data.status == 'draft'
              && request.resource.data.status == 'active'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'activatedAt', 'contentHash'])
              && isHeadOutcomeEvaluationRevision(userId, evaluationId, resource.data.revision))
            || (resource.data.status == 'active'
              && request.resource.data.status == 'completed'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
            || (resource.data.status == 'completed'
              && request.resource.data.status == 'archived'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          );
        allow delete: if false;
      }
    }

    function hasValidCompetitionOutcome(userId, outcomeId) {
      let data = request.resource.data;
      let result = data.result;
      return isOwner(userId)
        && data.keys().hasOnly(['id', 'eventRef', 'evaluationRef', 'sport', 'occurredAt', 'source', 'sourceRef', 'result', 'metrics', 'context', 'createdAt'])
        && data.keys().hasAll(['id', 'sport', 'occurredAt', 'source', 'result', 'metrics', 'context', 'createdAt'])
        && data.id == outcomeId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 160
        && (!('eventRef' in data) || (data.eventRef is string && data.eventRef.size() > 0 && data.eventRef.size() <= 256))
        && data.sport in ['cycling', 'running', 'field', 'other']
        && data.occurredAt is string && data.occurredAt.size() > 0
        && data.source in ['manual', 'garmin_activity', 'imported_result']
        && (data.source == 'manual' || ('sourceRef' in data && data.sourceRef is string && data.sourceRef.size() > 0 && data.sourceRef.size() <= 512))
        && (!('sourceRef' in data) || (data.sourceRef is string && data.sourceRef.size() > 0 && data.sourceRef.size() <= 512))
        && (!('evaluationRef' in data) || hasValidCompetitionOutcomeEvaluationRef(userId, data.evaluationRef))
        && (!('evaluationRef' in data) || competitionOutcomeEventMatchesEvaluation(userId, data.evaluationRef, ('eventRef' in data ? data.eventRef : '')))
        && result is map
        && result.keys().hasOnly(['completed', 'placing', 'fieldSize', 'elapsedSeconds', 'distanceM', 'courseId', 'summary'])
        && result.keys().hasAll(['completed'])
        && result.completed is bool
        && (!('placing' in result) || (result.placing is int && result.placing >= 1))
        && (!('fieldSize' in result) || (result.fieldSize is int && result.fieldSize >= 1))
        && (!('placing' in result) || !('fieldSize' in result) || result.placing <= result.fieldSize)
        && (!('elapsedSeconds' in result) || (result.elapsedSeconds is number && result.elapsedSeconds >= 0))
        && (!('distanceM' in result) || (result.distanceM is number && result.distanceM >= 0))
        && (!('courseId' in result) || (result.courseId is string && result.courseId.size() > 0 && result.courseId.size() <= 256))
        && (!('summary' in result) || (result.summary is string && result.summary.size() <= 4000))
        && data.metrics is map && data.metrics.size() <= 64
        && data.context is map && data.context.size() <= 64
        && data.createdAt is string && data.createdAt.size() > 0;
    }

    match /users/{userId}/competition_outcomes/{outcomeId} {
      allow read: if isOwner(userId);
      allow create: if hasValidCompetitionOutcome(userId, outcomeId);
      allow update, delete: if false;
    }
