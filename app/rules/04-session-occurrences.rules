

    match /users/{userId}/session_definitions/{definitionId} {
      function hasValidSessionDefinitionHeader(userId, definitionId) {
        let data = request.resource.data;
        return hasOwnedUserId(userId)
          && data.keys().hasOnly(['userId', 'definitionId', 'title', 'latestRevision', 'dominantModality', 'status', 'archivedAt', 'createdAt', 'updatedAt'])
          && data.definitionId == definitionId
          && isBoundedString(data.title, 200)
          && isPositiveInt(data.latestRevision)
          && (!('dominantModality' in data) || data.dominantModality is string)
          && (!('status' in data) || data.status in ['active', 'archived'])
          && (!('archivedAt' in data) || data.archivedAt is string)
          && (!('archivedAt' in data) || 'status' in data)
          && (!('status' in data) || data.status != 'archived' || data.archivedAt is string)
          && (!('status' in data) || data.status != 'active' || !('archivedAt' in data))
          && hasStringTimestamps(data);
      }

      // Issue #1202 (ADR-0053): schemaVersion, the intent enum and the blocks list type are
      // owned by validateSessionDefinition, which SessionDefinitionService.saveDefinitionRevision
      // runs before the create-only revision write. The path bindings, contentHash (computed
      // by the service, not validated) and the companionSessions list type (no TypeScript
      // check) stay. movementComposition is part of the SessionDefinition schema (catalog-based
      // manual sessions carry it); validateSessionDefinition owns its content.
      function hasValidSessionDefinitionRevision(userId, definitionId, revId) {
        let data = request.resource.data;
        return hasOwnedUserId(userId)
          && data.keys().hasOnly(['userId', 'definitionId', 'schemaVersion', 'id', 'revision', 'title', 'summary', 'intent', 'modalities', 'dominantModality', 'duration', 'defaultScheduledDate', 'sessionTargets', 'prohibitedAdditions', 'importWarnings', 'companionSessions', 'movementComposition', 'blocks', 'contentHash', 'createdAt'])
          && data.keys().hasAll(['userId', 'definitionId', 'id', 'revision', 'schemaVersion', 'title', 'intent', 'contentHash', 'blocks', 'createdAt'])
          && data.definitionId == definitionId
          && data.id == definitionId
          && data.revision is int && string(data.revision) == revId
          && data.contentHash is string && data.contentHash.size() > 0
          && (!('companionSessions' in data) || data.companionSessions is list);
      }

      allow read: if isOwner(userId);
      allow create: if hasValidSessionDefinitionHeader(userId, definitionId);
      allow update: if hasValidSessionDefinitionHeader(userId, definitionId)
        && keepsOwnership(userId)
        && request.resource.data.latestRevision >= resource.data.latestRevision
        && keepsCreatedAt();
      allow delete: if isOwner(userId);

      match /revisions/{revId} {
        allow read: if isOwner(userId);
        allow create: if hasValidSessionDefinitionRevision(userId, definitionId, revId);
      }
    }

    match /users/{userId}/session_occurrences/{occurrenceId} {
      function hasBoundedOccurrenceWindowBinding(binding) {
        return binding is map
          && binding.keys().hasOnly(['windowId', 'bundleId', 'order', 'boundStartLocal', 'boundEndLocal', 'startInstant', 'endInstant'])
          && binding.keys().hasAll(['windowId', 'bundleId', 'order', 'boundStartLocal', 'boundEndLocal', 'startInstant', 'endInstant'])
          && isBoundedString(binding.windowId, 128)
          && isBoundedString(binding.bundleId, 128);
      }

      // H4 (#434) PR 3 / ADR-0036 D-WINDOW: `windowBinding` on its own records the resolved
      // window an intraday member sits in but enforces nothing across documents -- real
      // exclusivity comes from `session_occurrence_windows` below, whose document id *is*
      // `(date, windowId)`.
      //
      // Issue #1202 (ADR-0053): the date value, the authority enum and its pairing with
      // exactly one ref, the definitionRef values, the externalPlanRef revision, the
      // window-binding order, local bounds and instants, the windowBinding-needs-externalPlanRef
      // rule and placementOrder are owned by validateSessionOccurrence
      // (assertValidSessionOccurrence), which every client writer runs before its
      // whole-document set. Ownership, the path binding, the key allow-lists, the id/hash caps,
      // the timestamps and the state enum stay, as do the required keys the removed value
      // checks used to imply, now explicit: `date`, `authority`, at least one ref, and every
      // key of each ref map and windowBinding. (userId, occurrenceId, state, createdAt and
      // updatedAt are already required by the kept checks.) The state enum is the domain of
      // the kept transition table, and the strength-session and session-execution rules read
      // `state` across documents.
      function hasValidSessionOccurrence(userId, occurrenceId) {
        let data = request.resource.data;
        return hasOwnedUserId(userId)
          && data.keys().hasOnly(['userId', 'occurrenceId', 'date', 'authority', 'definitionRef', 'externalPlanRef', 'windowBinding', 'state', 'placementOrder', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['date', 'authority'])
          && ('definitionRef' in data || 'externalPlanRef' in data)
          && (!('windowBinding' in data) || hasBoundedOccurrenceWindowBinding(data.windowBinding))
          && data.occurrenceId == occurrenceId
          && data.state in ['scheduled', 'active', 'superseded', 'completed', 'abandoned', 'missed', 'skipped']
          && (!('definitionRef' in data) || (
            data.definitionRef is map
            && data.definitionRef.keys().hasOnly(['definitionId', 'revision', 'contentHash'])
            && data.definitionRef.keys().hasAll(['definitionId', 'revision', 'contentHash'])
          ))
          && (!('externalPlanRef' in data) || (
            data.externalPlanRef is map
            && data.externalPlanRef.keys().hasOnly(['planId', 'revision', 'sessionId', 'contentHash'])
            && data.externalPlanRef.keys().hasAll(['planId', 'revision', 'sessionId', 'contentHash'])
            && isBoundedString(data.externalPlanRef.planId, 64)
            && isBoundedString(data.externalPlanRef.sessionId, 64)
            && isBoundedString(data.externalPlanRef.contentHash, 128)
          ))
          && hasStringTimestamps(data);
      }

      function isValidOccurrenceStateTransition(fromState, toState) {
        return fromState == toState
          || (fromState == 'scheduled' && toState in ['active', 'completed', 'abandoned', 'skipped', 'superseded', 'missed'])
          // H4 (#434) PR 3 Phase 4 step 11: `active -> scheduled` is the launch-claim rollback.
          // A claim commits before the session definition is resolved and the runner starts; if
          // that fails afterwards, the occurrence would otherwise be stranded `active` with no
          // execution and its minutes debited for the rest of the day.
          //
          // The rules cannot express the condition that makes this safe -- "no execution
          // references this occurrence" needs a query, which rules cannot run -- so it is
          // enforced in `releaseOccurrenceClaim`/`releaseIntradayMemberClaim`, which check for a
          // referencing execution and refuse to reverse a ledger row that has already been
          // reconciled by one. This clause is therefore deliberately wider than the guarded path
          // that uses it, and is the reason `VALID_OCCURRENCE_TRANSITIONS` in
          // `sessionOccurrenceService.ts` still omits it: the general
          // `transitionOccurrenceState` must not be able to un-claim a genuinely running session.
          || (fromState == 'active' && toState in ['completed', 'abandoned', 'superseded', 'scheduled']);
      }

      function bindsPreparedExternalOccurrence(userId, occurrenceId) {
        let data = request.resource.data;
        let binding = data.windowBinding;
        let reservationId = 'win-' + data.date + '-' + binding.windowId;
        let reservation = getAfter(/databases/$(database)/documents/users/$(userId)/session_occurrence_windows/$(reservationId));
        return resource.data.state == 'scheduled'
          && !('windowBinding' in resource.data)
          && !('placementOrder' in resource.data)
          && data.state == 'scheduled'
          && data.authority == 'external_plan'
          && data.externalPlanRef is map
          && binding.windowId.matches('^[A-Za-z0-9_-]{1,128}$')
          && data.placementOrder == binding.order
          && data.diff(resource.data).affectedKeys().hasOnly(['windowBinding', 'placementOrder', 'updatedAt'])
          && reservation.data.userId == userId
          && reservation.data.date == data.date
          && reservation.data.windowId == binding.windowId
          && reservation.data.occurrenceId == occurrenceId;
      }

      allow read: if isOwner(userId);
      allow create: if hasValidSessionOccurrence(userId, occurrenceId);
      allow update: if hasValidSessionOccurrence(userId, occurrenceId)
        && keepsOwnership(userId)
        && request.resource.data.date == resource.data.date
        && keepsCreatedAt()
        && request.resource.data.authority == resource.data.authority
        && isValidOccurrenceStateTransition(resource.data.state, request.resource.data.state)
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt'])
          || bindsPreparedExternalOccurrence(userId, occurrenceId)
        );
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/session_occurrence_windows/{reservationId} {
      // H4 (#434) PR 3 / ADR-0036 D-WINDOW: transactional exclusivity for "at most one
      // occurrence per resolved window". Document id is deterministic from (date, windowId)
      // (see `windowReservationId` in `sessionOccurrenceService.ts`), so a create-if-absent
      // write inside the same transaction that creates the occurrence is what makes a
      // duplicate binding to one window impossible -- `windowBinding` on the occurrence
      // itself is a snapshot, not an enforcement mechanism. Released by deletion in the same
      // transaction that supersedes/skips the occurrence holding it and binds a *different*
      // window, or handed to a same-window successor via the constrained update below.
      function hasValidWindowReservation(userId) {
        let data = request.resource.data;
        return hasOwnedUserId(userId)
          && data.keys().hasOnly(['userId', 'date', 'windowId', 'occurrenceId', 'createdAt'])
          && isValidActivityDate(data.date)
          && isBoundedString(data.windowId, 128)
          && isBoundedString(data.occurrenceId, 128)
          && data.createdAt is string;
      }

      allow read: if isOwner(userId);
      allow create: if hasValidWindowReservation(userId);
      // A re-import that keeps the same resolved window (`getOrCreateExternalPlanOccurrence`
      // superseding a stale-revision predecessor) hands this reservation to the successor
      // occurrence in place, rather than deleting and recreating it -- Firestore evaluates a
      // `set()` on an existing document as `update`, so the reservation-claiming write for
      // exactly that case needs an update rule, not just create. Everything the reservation's
      // *identity* is keyed on (`date`, `windowId`, ownership) stays immutable; only the
      // occurrence it points at (and the timestamp) may change.
      allow update: if hasValidWindowReservation(userId)
        && keepsOwnership(userId)
        && request.resource.data.date == resource.data.date
        && request.resource.data.windowId == resource.data.windowId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['occurrenceId', 'createdAt']);
      allow delete: if isOwner(userId);
    }
