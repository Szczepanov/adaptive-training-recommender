

    match /daily_recovery_snapshot/{date} { allow read, write: if false; }
    match /daily_subjective_checkin/{document=**} { allow read, write: if false; }

    match /users/{userId}/daily_subjective_checkins/{date} {
      // Issue #1201 rules scope: hunger, nutrition adherence and illness-answer values and
      // every health-context value (enums, ranges, symptom/presence coupling) are validated by
      // engine/validation.ts validateCheckin (validateHealthContext) in
      // checkinService.upsertCheckin before every write. Rules keep the key allow-lists and caps.
      function hasBoundedHealthContext(data) {
        let context = data.get('healthContext', {});
        let symptoms = context.get('symptoms', {});
        return context.keys().hasOnly(['alcoholDrinksLast24h', 'travelDisruption', 'timezoneShiftHours', 'unusualHeatOrSauna', 'dehydrationOrFluidLoss', 'recentVaccination', 'medicationChange', 'closeSickContact', 'otherDisruption', 'symptoms'])
          && (context.get('otherDisruption', null) == null || (context.otherDisruption is string && context.otherDisruption.size() <= 500))
          && symptoms.keys().hasOnly(['present', 'onset', 'severity', 'types', 'suspectedCause'])
          && (symptoms.get('types', null) == null || (symptoms.types is list && symptoms.types.size() <= 10));
      }

      // upsertCheckin writes with setDoc(..., {merge: true}), so validateCheckin sees only the
      // payload. These cross-field couplings are checked on the merged document instead: an
      // illness answer is present, and hunger and its timing are recorded together.
      function hasMergedCheckinCouplings(data) {
        let hasHunger = 'hunger1To10' in data && data.hunger1To10 != null;
        let hasTiming = 'hungerTiming' in data && data.hungerTiming != null;
        return (('illnessSymptoms' in data) || ('symptoms' in data.get('healthContext', {})))
          && hasHunger == hasTiming;
      }

      allow read: if isOwner(userId);
      allow create: if hasOwnedUserId(userId) && isDateDocument(date)
        && hasBoundedHealthContext(request.resource.data)
        && hasMergedCheckinCouplings(request.resource.data);
      allow update: if keepsOwnership(userId) && isDateDocument(date) && keepsCreatedAt()
        && hasBoundedHealthContext(request.resource.data)
        && hasMergedCheckinCouplings(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/health_anomaly_assessments/{date}/revisions/{revisionId} {
      // Issue #1201 rules scope: lower bounds, ordering, integer types and estimator enums are
      // owned by isHealthAnomalyThresholdPolicy, and the assessment state/evidence enums, source
      // revision types/timezone, version/mode equalities, revisionId format, computedAt, mode,
      // schemaVersion and integer/lower-bound checks by parseHealthAnomalyAssessmentRevision, both
      // run in HealthAnomalyAssessmentRepository.persistImmutable before the write. Upper bounds
      // that the TypeScript guard does not enforce stay here (a non-number fails them).
      function hasValidHealthAnomalyThresholdPolicy(policy) {
        return policy is map
          && policy.keys().hasOnly(['policyVersion', 'moderateDeviation', 'strongDeviation', 'minimumCoreSignalsForMultiSignal', 'persistenceDaysForEscalation', 'minimumHistoryCount', 'minimumRecentDayCoverage', 'maxBaselineAgeDays', 'estimatorBySignal'])
          && isBoundedString(policy.policyVersion, 128)
          && policy.moderateDeviation <= 20
          && policy.strongDeviation <= 20
          && policy.persistenceDaysForEscalation <= 30
          && policy.minimumHistoryCount <= 28
          && policy.maxBaselineAgeDays <= 30
          && policy.estimatorBySignal is map
          && policy.estimatorBySignal.keys().hasOnly(['rhr', 'respiration', 'hrv'])
          && policy.estimatorBySignal.keys().hasAll(['rhr', 'respiration', 'hrv']);
      }

      function hasValidHealthAnomalyRevision(userId, date, revisionId) {
        let data = request.resource.data;
        let source = data.source;
        let assessment = data.assessment;
        return isOwner(userId)
          && data.keys().hasOnly(['userId', 'date', 'revisionId', 'idempotencyKey', 'computedAt', 'policyVersion', 'thresholdPolicy', 'mode', 'source', 'assessment', 'schemaVersion'])
          && data.userId == userId
          && data.date == date
          && isValidActivityDate(data.date)
          && data.revisionId == revisionId
          && isBoundedString(data.idempotencyKey, 160)
          && isBoundedString(data.policyVersion, 128)
          && hasValidHealthAnomalyThresholdPolicy(data.thresholdPolicy)
          && source is map
          && source.keys().hasOnly(['timezone', 'recoverySnapshotRevision', 'checkinRevision', 'historyWindowStart', 'historyWindowEndExclusive', 'historySnapshotRevisions', 'travelContextRevision', 'persistenceLookbackStart'])
          && source.keys().hasAll(['timezone', 'recoverySnapshotRevision', 'checkinRevision', 'historyWindowStart', 'historyWindowEndExclusive', 'historySnapshotRevisions', 'travelContextRevision', 'persistenceLookbackStart'])
          && isValidActivityDate(source.historyWindowStart)
          && source.historyWindowEndExclusive == date
          && source.historySnapshotRevisions is list && source.historySnapshotRevisions.size() <= 28
          && isValidActivityDate(source.persistenceLookbackStart)
          && assessment is map
          && assessment.keys().hasOnly(['state', 'evidenceLevel', 'coreSignals', 'supportingSignals', 'explanations', 'unexplainedEvidence', 'persistenceDays', 'episodeId', 'episodeDay', 'dataQuality', 'rationale', 'respirationElevation', 'policyVersion', 'thresholdPolicyVersion', 'mode'])
          && assessment.keys().hasAll(['state', 'evidenceLevel', 'coreSignals', 'supportingSignals', 'explanations', 'unexplainedEvidence', 'persistenceDays', 'episodeId', 'episodeDay', 'dataQuality', 'rationale', 'policyVersion', 'thresholdPolicyVersion', 'mode'])
          && assessment.coreSignals is list && assessment.coreSignals.size() == 3
          && assessment.supportingSignals is list && assessment.supportingSignals.size() <= 32
          && assessment.explanations is list && assessment.explanations.size() <= 32
          && assessment.unexplainedEvidence is list && assessment.unexplainedEvidence.size() <= 3
          && assessment.persistenceDays <= 365
          && (assessment.episodeId == null || (assessment.episodeId is string && assessment.episodeId.size() <= 160))
          && (assessment.episodeDay == null || assessment.episodeDay <= 365)
          && assessment.dataQuality is list && assessment.dataQuality.size() <= 3
          && assessment.rationale is map
          // Keep the server boundary bounded; the application parser validates every scalar.
          && (!('respirationElevation' in assessment)
            || (assessment.respirationElevation is map && assessment.respirationElevation.size() <= 11));
      }

      allow read: if isOwner(userId);
      allow create: if hasValidHealthAnomalyRevision(userId, date, revisionId);
    }

    match /users/{userId}/health_anomaly_outcomes/{episodeId} {
      function hasValidHealthAnomalyOutcome(userId, episodeId) {
        let data = request.resource.data;
        let sourceAssessment = data.sourceAssessment;
        let symptomOnset = data.symptomOnset;
        let respiratoryTest = data.respiratoryTest;
        let assessmentPath = /databases/$(database)/documents/users/$(userId)/health_anomaly_assessments/$(sourceAssessment.date)/revisions/$(sourceAssessment.revisionId);
        return hasOwnedUserId(userId)
          && data.keys().hasOnly(['userId', 'episodeId', 'sourceAssessment', 'explanation', 'symptomOnset', 'respiratoryTest', 'note', 'createdAt', 'updatedAt', 'schemaVersion'])
          && data.keys().hasAll(['userId', 'episodeId', 'sourceAssessment', 'explanation', 'symptomOnset', 'respiratoryTest', 'note', 'createdAt', 'updatedAt', 'schemaVersion'])
          && data.episodeId == episodeId
          && isBoundedString(data.episodeId, 160)
          && sourceAssessment is map
          && sourceAssessment.keys().hasOnly(['date', 'revisionId'])
          && sourceAssessment.keys().hasAll(['date', 'revisionId'])
          && isValidActivityDate(sourceAssessment.date)
          && sourceAssessment.revisionId is string && sourceAssessment.revisionId.matches('^ha-[0-9a-f]{16}$')
          && exists(assessmentPath)
          && get(assessmentPath).data.assessment.episodeId == episodeId
          && data.explanation in ['illness_symptoms', 'allergy_or_hay_fever', 'hard_training_recovery', 'poor_sleep', 'alcohol', 'travel_jetlag', 'stress', 'heat_dehydration', 'vaccination_medication', 'nothing_obvious', 'other_not_sure']
          && (symptomOnset == null || (
            symptomOnset is map
            && symptomOnset.keys().hasOnly(['date', 'precision'])
            && symptomOnset.keys().hasAll(['date', 'precision'])
            && isValidActivityDate(symptomOnset.date)
            && symptomOnset.precision == 'day'
          ))
          && (respiratoryTest == null || (
            respiratoryTest is map
            && respiratoryTest.keys().hasOnly(['result', 'testedOn', 'source'])
            && respiratoryTest.keys().hasAll(['result', 'testedOn', 'source'])
            && respiratoryTest.result in ['positive', 'negative']
            && isValidActivityDate(respiratoryTest.testedOn)
            && respiratoryTest.source == 'user_reported'
          ))
          && (data.note == null || (data.note is string && data.note.size() <= 2000))
          && data.createdAt is string && data.createdAt.size() > 0
          && data.updatedAt is string && data.updatedAt.size() > 0
          && data.schemaVersion == 1;
      }

      allow read: if isOwner(userId);
      allow create: if hasValidHealthAnomalyOutcome(userId, episodeId);
      allow update: if hasValidHealthAnomalyOutcome(userId, episodeId)
        && keepsOwnership(userId)
        && request.resource.data.episodeId == resource.data.episodeId
        && request.resource.data.sourceAssessment == resource.data.sourceAssessment
        && keepsCreatedAt()
        && request.resource.data.schemaVersion == resource.data.schemaVersion;
    }

    // --- PI6/ADR-0028: physiological identity passports and immutable assessments are
    // server-managed. Clients may read their own evidence but cannot forge model output.
    match /users/{userId}/physiological_identity_passports/{passportId} {
      allow read: if isOwner(userId) && passportId == 'current';
    }

    match /users/{userId}/physiological_identity_passport_versions/{versionId} {
      allow read: if isOwner(userId);
    }

    match /users/{userId}/health_identity_assessments/{assessmentId} {
      allow read: if isOwner(userId);
    }

    match /users/{userId}/health_identity_review_events/{eventId} {
      function hasValidIdentityReviewEvent(userId, eventId) {
        let data = request.resource.data;
        let assessmentPath = /databases/$(database)/documents/users/$(userId)/health_identity_assessments/$(data.assessmentId);
        let supersededPath = /databases/$(database)/documents/users/$(userId)/health_identity_review_events/$(data.supersedesReviewEventId);
        return isOwner(userId)
          && data.keys().hasOnly(['id', 'assessmentId', 'schemaVersion', 'label', 'occupancyAttestation', 'supersedesReviewEventId', 'recordedAt', 'source'])
          && data.keys().hasAll(['id', 'assessmentId', 'schemaVersion', 'label', 'occupancyAttestation', 'supersedesReviewEventId', 'recordedAt', 'source'])
          && data.id == eventId
          && isBoundedString(data.id, 160)
          && isBoundedString(data.assessmentId, 160)
          && data.schemaVersion == 1
          && data.label in ['USER', 'NOT_USER', 'UNCERTAIN']
          && data.occupancyAttestation in ['EXCLUSIVE', 'MIXED', 'UNKNOWN']
          && data.recordedAt is timestamp
          && data.recordedAt == request.time
          && data.source == 'user_ui'
          && exists(assessmentPath)
          // Label/occupancy pairing is owned by identityPersistence.ts assertUserReviewSemantics
          // (IdentityPersistenceService.submitUserReview) -- issue #1201 rules scope.
          && (
            data.supersedesReviewEventId == null
            || (
              data.supersedesReviewEventId is string
              && data.supersedesReviewEventId.size() > 0
              && data.supersedesReviewEventId != eventId
              && exists(supersededPath)
              && get(supersededPath).data.assessmentId == data.assessmentId
              && data.recordedAt >= get(supersededPath).data.recordedAt
            )
          );
      }

      allow read: if isOwner(userId);
      allow create: if hasValidIdentityReviewEvent(userId, eventId);
    }

    // --- MS2/ADR-0027: server-owned multisource health observation day bundles.
    match /users/{userId}/health_observation_days/{daySourceId} {
      allow read: if isOwner(userId);
      // Server-managed only: client writes denied by default.
    }
