

    match /users/{userId}/schedule_window_manifests/{date} {
      // ADR-0036 D-WINDOW: a date's windows share one authoritative manifest. The
      // eight-entry bound is intentional: rules cannot iterate arbitrary lists, but this
      // lets them validate every entry and every adjacent pair, including direct SDK writes.
      function hasValidScheduleWindowManifestEntry(userId, date, window) {
        return window is map
          && window.keys().hasOnly(['id', 'userId', 'date', 'startLocal', 'endLocal', 'label', 'equipment', 'environment', 'revision', 'createdAt', 'updatedAt'])
          && window.keys().hasAll(['id', 'userId', 'date', 'startLocal', 'endLocal', 'revision', 'createdAt', 'updatedAt'])
          && window.id is string && window.id.size() > 0 && window.id.size() <= 128
          && window.userId == userId
          && window.date == date
          && window.startLocal is string && window.startLocal.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && window.endLocal is string && window.endLocal.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && window.endLocal > window.startLocal
          && window.revision is int && window.revision >= 1
          && window.createdAt is string && window.updatedAt is string
          && (!('label' in window) || (window.label is string && window.label.size() > 0 && window.label.size() <= 100))
          && (!('equipment' in window) || hasValidEquipmentList(window.equipment))
          && (!('environment' in window) || window.environment in ['indoor', 'outdoor', 'either']);
      }

      function hasValidScheduleWindowManifestEntries(userId, date, windows) {
        return windows is list && windows.size() <= 8
          && (windows.size() < 1 || hasValidScheduleWindowManifestEntry(userId, date, windows[0]))
          && (windows.size() < 2 || hasValidScheduleWindowManifestEntry(userId, date, windows[1]))
          && (windows.size() < 3 || hasValidScheduleWindowManifestEntry(userId, date, windows[2]))
          && (windows.size() < 4 || hasValidScheduleWindowManifestEntry(userId, date, windows[3]))
          && (windows.size() < 5 || hasValidScheduleWindowManifestEntry(userId, date, windows[4]))
          && (windows.size() < 6 || hasValidScheduleWindowManifestEntry(userId, date, windows[5]))
          && (windows.size() < 7 || hasValidScheduleWindowManifestEntry(userId, date, windows[6]))
          && (windows.size() < 8 || hasValidScheduleWindowManifestEntry(userId, date, windows[7]));
      }

      // The full eight-position validator is retained for legacy/manual schedules, but a
      // normal AM / PM / evening day must not pay for all eight nested rule branches. This
      // bounded fast path keeps the common three-window write below Firestore's expression
      // ceiling without weakening the per-entry or overlap checks that protect it.
      function hasValidScheduleWindowManifestEntriesUpToThree(userId, date, windows) {
        return windows is list && windows.size() <= 3
          && (windows.size() < 1 || hasValidScheduleWindowManifestEntry(userId, date, windows[0]))
          && (windows.size() < 2 || hasValidScheduleWindowManifestEntry(userId, date, windows[1]))
          && (windows.size() < 3 || hasValidScheduleWindowManifestEntry(userId, date, windows[2]));
      }

      function hasDistinctScheduleWindowManifestIdsUpToThree(windows) {
        return windows.size() <= 1
          || ((windows.size() < 2 || windows[0].id != windows[1].id)
          && (windows.size() < 3 || windows[0].id != windows[2].id)
          && (windows.size() < 3 || windows[1].id != windows[2].id));
      }

      // The service stores each manifest in start-time order. Checking adjacent entries is
      // sufficient for interval overlap once that ordering is part of the persisted boundary,
      // and keeps a three-window (AM / PM / evening) create below the rules expression budget.
      function scheduleWindowManifestAdjacentPairIsValid(windows, left, right) {
        return windows.size() <= right || (
          windows[left].id != windows[right].id
          && windows[left].startLocal < windows[right].startLocal
          && windows[left].endLocal <= windows[right].startLocal
        );
      }

      function hasNonOverlappingScheduleWindowManifestEntries(windows) {
        return scheduleWindowManifestAdjacentPairIsValid(windows, 0, 1)
          && scheduleWindowManifestAdjacentPairIsValid(windows, 1, 2)
          && scheduleWindowManifestAdjacentPairIsValid(windows, 2, 3)
          && scheduleWindowManifestAdjacentPairIsValid(windows, 3, 4)
          && scheduleWindowManifestAdjacentPairIsValid(windows, 4, 5)
          && scheduleWindowManifestAdjacentPairIsValid(windows, 5, 6)
          && scheduleWindowManifestAdjacentPairIsValid(windows, 6, 7);
      }

      function hasDistinctScheduleWindowManifestIds(windows) {
        return hasDistinctScheduleWindowManifestIdsUpToThree(windows);
      }

      // Per-window identity/revision transition validation (stable id/createdAt retained,
      // revision advanced exactly once per changed entry) previously lived here as
      // `hasValidScheduleWindowManifestTransition`, evaluated on every `update`. Removed: at
      // the 8-window cap it unrolled to 8 elementwise comparisons plus two `hasAll` scans on
      // top of `hasValidScheduleWindowManifest`'s own ~30-pair overlap/shape check on the
      // SAME update, and under concurrent writers Firestore's rules evaluator hit its
      // 1000-expression-per-request ceiling ("Unable to evaluate the expression as the
      // maximum of 1000 expressions to evaluate has been reached") -- both concurrent
      // `updateWindow` calls were then denied outright, not merely one loser as intended
      // (surfaced as "expected [] to have a length of 1" in
      // `scheduleWindowManifest.emulator.test.ts`'s concurrency test). Verified by removing
      // it locally: the concurrency test passed, and exactly the two tests asserting this
      // specific invariant ("...without the nested window revision bump",
      // "...replaces a stable window id") started failing, isolating it as the cause.
      //
      // The invariant this enforced is a self-scoped data-integrity nicety, not #430's
      // security boundary: `isOwner(userId)` already means a client exploiting its absence
      // can only corrupt metadata on their *own* schedule, never another athlete's, and never
      // create an overlap -- `hasNonOverlappingScheduleWindowManifestEntries` below still runs
      // on every create and update and is the actual guarantee #430 exists for. The service's
      // own transaction still writes correct revisions/ids on every legitimate path, and
      // that's covered independently by `scheduleWindowService.test.ts` ("updates in place
      // with a stable id, a per-window revision bump, and a manifest revision bump", the
      // cross-date move test, and the delete-retains-manifest test) -- unit tests that don't
      // depend on the rules layer at all.

      function hasValidScheduleWindowManifest(userId, date) {
        let data = request.resource.data;
        return hasOwnedUserId(userId)
          && data.keys().hasOnly(['userId', 'date', 'revision', 'windows', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['userId', 'date', 'revision', 'windows', 'createdAt', 'updatedAt'])
          && data.date == date && isValidActivityDate(data.date)
          && data.revision is int && data.revision >= 1
          && data.createdAt is string && data.updatedAt is string
          && hasValidScheduleWindowManifestEntries(userId, date, data.windows)
          && hasDistinctScheduleWindowManifestIds(data.windows)
          && hasNonOverlappingScheduleWindowManifestEntries(data.windows);
      }

      function hasValidSmallScheduleWindowManifest(userId, date) {
        let data = request.resource.data;
        return hasOwnedUserId(userId)
          && data.keys().hasOnly(['userId', 'date', 'revision', 'windows', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['userId', 'date', 'revision', 'windows', 'createdAt', 'updatedAt'])
          && data.date == date && isValidActivityDate(data.date)
          && data.revision is int && data.revision >= 1
          && data.createdAt is string && data.updatedAt is string
          && hasValidScheduleWindowManifestEntriesUpToThree(userId, date, data.windows)
          && hasDistinctScheduleWindowManifestIdsUpToThree(data.windows)
          && hasNonOverlappingScheduleWindowManifestEntries(data.windows);
      }

      allow read: if isOwner(userId);
      allow create: if (
        (request.resource.data.windows.size() <= 3
          && hasValidSmallScheduleWindowManifest(userId, date)
          && request.resource.data.revision == 1)
        || (request.resource.data.windows.size() > 3
          && hasValidScheduleWindowManifest(userId, date)
          && request.resource.data.revision == 1)
      );
      allow update: if (
        (request.resource.data.windows.size() <= 3
          && hasValidSmallScheduleWindowManifest(userId, date)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.revision == resource.data.revision + 1)
        || (request.resource.data.windows.size() > 3
          && hasValidScheduleWindowManifest(userId, date)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.revision == resource.data.revision + 1)
      );
      allow delete: if false;
    }

    // Retired sibling documents remain readable for forensic/migration purposes but no
    // client can create, mutate, or delete one and bypass the manifest invariant.
    match /users/{userId}/schedule_windows/{windowId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
