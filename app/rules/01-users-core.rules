

    match /users/{userId}/decision_journal/{date} {
      // Issue #1202 (ADR-0053): the verdict enums, the sawEngineVerdictFirst type and
      // schemaVersion are owned by validateDecisionJournalEntry, which
      // DecisionJournalService.write runs before every write. That write merges, but its
      // payload is the whole validated entry (absent optional keys are deleted), so the
      // merged document is the validated payload.
      function hasValidDecisionJournalEntry(userId, date) {
        let data = request.resource.data;
        return hasOwnedUserId(userId)
          && isDateDocument(date)
          && data.keys().hasOnly(['userId', 'date', 'externalVerdict', 'externalNote', 'sawEngineVerdictFirst', 'actualVerdict', 'createdAt', 'updatedAt', 'schemaVersion'])
          && data.keys().hasAll(['userId', 'date', 'externalVerdict', 'sawEngineVerdictFirst', 'createdAt', 'updatedAt', 'schemaVersion'])
          && (!('externalNote' in data) || (data.externalNote is string && data.externalNote.size() <= 2000))
          && hasStringTimestamps(data);
      }

      allow read: if isOwner(userId);
      allow create: if hasValidDecisionJournalEntry(userId, date);
      allow update: if keepsOwnership(userId)
        && hasValidDecisionJournalEntry(userId, date)
        && keepsCreatedAt()
        && request.resource.data.sawEngineVerdictFirst == resource.data.sawEngineVerdictFirst
        && request.resource.data.externalVerdict == resource.data.externalVerdict
        && (('externalNote' in request.resource.data) == ('externalNote' in resource.data))
        && (!('externalNote' in resource.data) || request.resource.data.externalNote == resource.data.externalNote);
    }

    match /users/{userId}/goals/{goalId} {
      function hasValidGoalTaper() {
        return !('taper' in request.resource.data)
          || (request.resource.data.taper is map
            && request.resource.data.taper.keys().hasOnly(['startDate'])
            && request.resource.data.taper.startDate is string
            && request.resource.data.taper.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }

      // ADR-0041: rules can only validate bounded structure and exact keys -- they cannot
      // prove membership in the application's metric/exercise/performance-test registries.
      // Semantic validation (validatePerformanceTargetForDomain) is enforced by
      // goalService.ts at both write and read boundaries; validateGoal itself deliberately
      // remains structural-only to preserve the observations/engine isolation boundary.
      // Rules are therefore a structural backstop, not the registry authority.
      function hasValidGoalPerformanceTarget() {
        return !('performanceTarget' in request.resource.data)
          || request.resource.data.performanceTarget == null
          || (request.resource.data.performanceTarget is map
            && request.resource.data.performanceTarget.keys().hasOnly(['kind', 'metricId', 'subjectRef', 'targetValue'])
            && request.resource.data.performanceTarget.kind == 'performance_metric'
            && request.resource.data.performanceTarget.metricId is string
            && request.resource.data.performanceTarget.metricId.size() > 0
            && request.resource.data.performanceTarget.targetValue is number
            && request.resource.data.performanceTarget.subjectRef is map
            && (
              (request.resource.data.performanceTarget.subjectRef.keys().hasOnly(['kind', 'exerciseId'])
                && request.resource.data.performanceTarget.subjectRef.kind == 'exercise'
                && request.resource.data.performanceTarget.subjectRef.exerciseId is string
                && request.resource.data.performanceTarget.subjectRef.exerciseId.size() > 0)
              || (request.resource.data.performanceTarget.subjectRef.keys().hasOnly(['kind', 'performanceTestId'])
                && request.resource.data.performanceTarget.subjectRef.kind == 'performance_test'
                && request.resource.data.performanceTarget.subjectRef.performanceTestId is string
                && request.resource.data.performanceTarget.subjectRef.performanceTestId.size() > 0)
            ));
      }

      allow read: if isOwner(userId);
      allow create: if hasOwnedUserId(userId) && hasValidGoalTaper() && hasValidGoalPerformanceTarget();
      allow update: if keepsOwnership(userId) && keepsCreatedAt() && hasValidGoalTaper() && hasValidGoalPerformanceTarget();
      allow delete: if isOwner(userId);
    }

    function isValidEquipmentItem(item) {
      return item is string && item.size() <= 50;
    }

    // Each item must be a string of at most 50 characters, matching
    // validationCore.ts's MAX_EQUIPMENT_ITEM_LENGTH -- otherwise an owner could persist
    // e.g. equipment: [42] past rules and have the client-side parser (validateFixedActivity/
    // validateScheduleWindow) reject the whole document as INVALID on read.
    function hasValidEquipmentList(list) {
      let sz = list.size();
      return list is list && sz <= 20
        && (sz <= 0 || isValidEquipmentItem(list[0]))
        && (sz <= 1 || isValidEquipmentItem(list[1]))
        && (sz <= 2 || isValidEquipmentItem(list[2]))
        && (sz <= 3 || isValidEquipmentItem(list[3]))
        && (sz <= 4 || isValidEquipmentItem(list[4]))
        && (sz <= 5 || isValidEquipmentItem(list[5]))
        && (sz <= 6 || isValidEquipmentItem(list[6]))
        && (sz <= 7 || isValidEquipmentItem(list[7]))
        && (sz <= 8 || isValidEquipmentItem(list[8]))
        && (sz <= 9 || isValidEquipmentItem(list[9]))
        && (sz <= 10 || isValidEquipmentItem(list[10]))
        && (sz <= 11 || isValidEquipmentItem(list[11]))
        && (sz <= 12 || isValidEquipmentItem(list[12]))
        && (sz <= 13 || isValidEquipmentItem(list[13]))
        && (sz <= 14 || isValidEquipmentItem(list[14]))
        && (sz <= 15 || isValidEquipmentItem(list[15]))
        && (sz <= 16 || isValidEquipmentItem(list[16]))
        && (sz <= 17 || isValidEquipmentItem(list[17]))
        && (sz <= 18 || isValidEquipmentItem(list[18]))
        && (sz <= 19 || isValidEquipmentItem(list[19]));
    }

    match /users/{userId}/fixed_activities/{activityId} {
      function hasValidExpectedStimulus(m) {
        return m is map
          && m.keys().hasOnly(['aerobicEndurance', 'thresholdPower', 'vo2MaxPower', 'repeatedSurges', 'sprintPower', 'fatigueResistance', 'maxStrength', 'hypertrophy']);
      }

      function hasValidAvailabilityContextOverride(m) {
        return m is map
          && m.keys().hasOnly(['environment', 'equipment'])
          && (!('equipment' in m) || hasValidEquipmentList(m.equipment));
      }

      function hasValidOptionalCatalogId(data, key) {
        return !(key in data) || (data[key] is string && data[key].size() > 0 && data[key].size() <= 120);
      }

      // Issue #1202 (ADR-0053): date, durationMin, the fixed/isCompleted flags, the
      // environment enums, startTime, the stimulus/cost axis values and availabilityOverride
      // are owned by validateFixedActivity, which FixedActivityService.createActivity and
      // updateActivity run before every write. updateActivity merges, but every check that
      // moved is per-field, and nested stimulus/cost/context maps merge key by key, so each
      // merged value was validated on the write that set it. createdAt stays: the validator
      // passes a stored createdAt through without type-checking it.
      function hasValidFixedActivity(userId) {
        let data = request.resource.data;
        return hasOwnedUserId(userId)
          && data.keys().hasOnly(['userId', 'title', 'date', 'startTime', 'durationMin', 'fixed', 'expectedStimulus', 'expectedCost', 'environment', 'equipment', 'availabilityOverride', 'availabilityContextOverride', 'templateId', 'workoutId', 'isCompleted', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['userId', 'title', 'date', 'durationMin', 'fixed', 'environment', 'isCompleted', 'createdAt', 'updatedAt'])
          && data.title is string && data.title.size() <= 200
          && hasStringTimestamps(data)
          && (!('expectedStimulus' in data) || hasValidExpectedStimulus(data.expectedStimulus))
          && (!('expectedCost' in data) || hasValidExpectedCost(data.expectedCost))
          && (!('equipment' in data) || hasValidEquipmentList(data.equipment))
          && (!('availabilityContextOverride' in data) || hasValidAvailabilityContextOverride(data.availabilityContextOverride))
          && hasValidOptionalCatalogId(data, 'templateId')
          && hasValidOptionalCatalogId(data, 'workoutId');
      }

      allow read: if isOwner(userId);
      allow create: if hasValidFixedActivity(userId);
      allow update: if hasValidFixedActivity(userId)
        && keepsOwnership(userId)
        && keepsCreatedAt();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/training_intent/profile {
      // Issue #805: optional, default-off capability-maintenance opt-in. Absent = opted out.
      // Issue #1202 (ADR-0053): the capability enum, uniqueness, the enabled type and the
      // enabled-needs-a-capability rule are owned by validateTrainingIntentProfile.
      function hasValidCapabilityMaintenance(value) {
        return value is map
          && value.keys().hasOnly(['enabled', 'capabilities'])
          && value.keys().hasAll(['enabled', 'capabilities'])
          && value.capabilities is list
          && value.capabilities.size() <= 4;
      }

      // Issue #1202 (ADR-0053): planningMode, the weeklyCommitment counts and ordering,
      // organizationPreference and schemaVersion are owned by validateTrainingIntentProfile,
      // which TrainingIntentProfileService.upsert runs before every write. upsert merges,
      // but the validator requires all three weeklyCommitment keys and both
      // capabilityMaintenance keys, so each nested map it writes is replaced whole.
      function hasValidTrainingIntentProfile(userId) {
        let data = request.resource.data;
        let commitment = data.weeklyCommitment;
        return hasOwnedUserId(userId)
          && data.keys().hasOnly(['userId', 'planningMode', 'priorities', 'weeklyCommitment', 'organizationPreference', 'schemaVersion', 'createdAt', 'updatedAt', 'capabilityMaintenance'])
          && (!('capabilityMaintenance' in data) || hasValidCapabilityMaintenance(data.capabilityMaintenance))
          && data.keys().hasAll(['userId', 'planningMode', 'priorities', 'weeklyCommitment', 'organizationPreference', 'schemaVersion', 'createdAt', 'updatedAt'])
          && data.priorities is list && data.priorities.size() <= 6
          && data.weeklyCommitment is map
          && commitment.keys().hasOnly(['minSessions', 'targetSessions', 'maxSessions'])
          && commitment.keys().hasAll(['minSessions', 'targetSessions', 'maxSessions'])
          && hasStringTimestamps(data);
      }

      allow read: if isOwner(userId);
      allow create: if hasValidTrainingIntentProfile(userId);
      allow update: if hasValidTrainingIntentProfile(userId)
        && keepsOwnership(userId)
        && keepsCreatedAt();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/constraints/{constraintId} {
      allow read: if isOwner(userId);
      // Server-managed: client writes denied by default.
    }

    match /users/{userId}/preferences/profile {
      function hasValidUnavailableModalities(data) {
        return !('unavailableModalities' in data)
          || (data.unavailableModalities is list
            && data.unavailableModalities.size() <= 9
            && data.unavailableModalities.hasOnly(['Running', 'Cycling', 'Swimming', 'Walking', 'Strength', 'Field', 'Mobility', 'Cross Training', 'Rowing']));
      }

      allow read: if isOwner(userId);
      allow create: if hasOwnedUserId(userId) && hasValidUnavailableModalities(request.resource.data);
      allow update: if keepsOwnership(userId) && keepsCreatedAt()
        && hasValidUnavailableModalities(request.resource.data);
    }

    match /users/{userId}/trainingSettings/profile {
      function hasValidInjuryList(injuries) {
        return injuries is list && injuries.size() <= 20;
      }

      allow read: if isOwner(userId);
      allow create: if hasOwnedUserId(userId)
        && request.resource.data.schemaVersion in [2, 3]
        && (!('injuries' in request.resource.data) || hasValidInjuryList(request.resource.data.injuries))
        && (!('injuryHistory' in request.resource.data) || request.resource.data.injuryHistory is list);
      allow update: if keepsOwnership(userId)
        && keepsCreatedAt()
        && request.resource.data.schemaVersion in [2, 3]
        && (!('injuries' in request.resource.data) || hasValidInjuryList(request.resource.data.injuries))
        && (!('injuryHistory' in request.resource.data) || request.resource.data.injuryHistory is list);
    }

    match /users/{userId}/daily_recovery_snapshots/{date} {
      allow read: if isOwner(userId);
      // Server-managed: client writes denied by default.
    }

    match /users/{userId}/activities/{activityId} {
      allow read: if isOwner(userId);
      // Server-managed: client writes denied by default.
    }

    match /users/{userId}/activity_annotations/{activityId} {
      function hasValidAnnotationRpe(value) {
        return value == null || (value is number && value >= 1 && value <= 10);
      }

      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['rpe', 'equipmentLabel', 'source'])
        && request.resource.data.keys().hasAll(['rpe', 'equipmentLabel', 'source'])
        && hasValidAnnotationRpe(request.resource.data.rpe)
        && (request.resource.data.equipmentLabel == null
          || (request.resource.data.equipmentLabel is string
            && request.resource.data.equipmentLabel.size() >= 1
            && request.resource.data.equipmentLabel.size() <= 100
            && request.resource.data.equipmentLabel.trim() == request.resource.data.equipmentLabel))
        && request.resource.data.source == 'manual';

      match /laps/{lapId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['lapIndex', 'averagePowerWatts', 'rpe', 'source'])
          && request.resource.data.keys().hasAll(['lapIndex', 'averagePowerWatts', 'rpe', 'source'])
          && request.resource.data.lapIndex is int
          && request.resource.data.lapIndex >= 0
          && request.resource.data.lapIndex <= 9007199254740991
          && string(request.resource.data.lapIndex) == lapId
          && (request.resource.data.averagePowerWatts == null
            || (request.resource.data.averagePowerWatts is number
              && request.resource.data.averagePowerWatts >= 0
              && request.resource.data.averagePowerWatts <= 10000))
          && hasValidAnnotationRpe(request.resource.data.rpe)
          && (request.resource.data.averagePowerWatts != null || request.resource.data.rpe != null)
          && request.resource.data.source == 'manual';
      }
    }

    match /users/{userId}/activity_overrides/{activityId} {
      // Issue #1202 (ADR-0053): the date format, the modality and intensity enums, the rpe
      // range and the stimulusFocus enum are owned by validateActivityOverride, which
      // ActivityOverrideService.saveOverride (the only writer, a whole-document setDoc) runs
      // before every write. The update rule pins date to the stored value and no other rule
      // reads this document. The activityId binding, key allow-lists, string caps (the
      // originalIntensityTag cap needs its string type) and timestamp shape stay.
      function hasValidActivityOverride(userId, activityId) {
        let data = request.resource.data;
        return hasOwnedUserId(userId)
          && data.activityId == activityId
          && data.keys().hasOnly(['activityId', 'userId', 'date', 'originalType', 'originalIntensityTag', 'overriddenModality', 'overriddenIntensity', 'rpe', 'stimulusFocus', 'notes', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['activityId', 'userId', 'date', 'originalType', 'originalIntensityTag', 'overriddenModality', 'overriddenIntensity', 'createdAt', 'updatedAt'])
          && isBoundedString(data.originalType, 128)
          && data.originalIntensityTag is string && data.originalIntensityTag.size() <= 64
          && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 2000))
          && data.createdAt is string && data.createdAt.size() > 0
          && data.updatedAt is string && data.updatedAt.size() > 0;
      }

      allow read: if isOwner(userId);
      allow create: if hasValidActivityOverride(userId, activityId);
      allow update: if hasValidActivityOverride(userId, activityId)
        && keepsOwnership(userId)
        && request.resource.data.activityId == resource.data.activityId
        && request.resource.data.date == resource.data.date
        && keepsCreatedAt();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/gear/{gearId} {
      allow read: if isOwner(userId);
      // Server-managed: client writes denied by default.
    }

    match /users/{userId}/strength_sessions/{sessionId} {
      function isStrengthSessionDocument(sessionId) {
        return request.resource.data.sessionId == sessionId;
      }

      // Issue #1202 (ADR-0053): the date and sourceRecommendationDate formats, the
      // completedAt type, the sessionRpe range and schemaVersion are owned by
      // validateStrengthSession (assertValidStrengthSession), which StrengthSessionService
      // runs on the new document in startSession (the only create) and on the whole
      // post-transition document in transitionState before its merge. The merges
      // (transitionState, saveExercises) only touch state, updatedAt, completedAt,
      // sessionRpe, notes and exercises, so every other stored value is the create-validated
      // one; the update rule pins date and startedAt. The state enum and its completedAt
      // coupling stay: the update immutability reads state.
      function hasValidStrengthSession(userId, sessionId) {
        let data = request.resource.data;
        return hasOwnedUserId(userId)
          && isStrengthSessionDocument(sessionId)
          && data.keys().hasOnly(['userId', 'sessionId', 'date', 'startedAt', 'completedAt', 'updatedAt', 'state', 'sourceRecommendationDate', 'exercises', 'sessionRpe', 'notes', 'completionEvidence', 'schemaVersion'])
          && data.keys().hasAll(['userId', 'sessionId', 'date', 'startedAt', 'updatedAt', 'state', 'exercises', 'schemaVersion'])
          && isBoundedString(data.sessionId, 128)
          && data.startedAt is string && data.startedAt.size() > 0
          && data.updatedAt is string && data.updatedAt.size() > 0
          && data.state in ['in_progress', 'completed', 'abandoned']
          && ((data.state == 'completed') == ('completedAt' in data))
          && data.exercises is list && data.exercises.size() <= 30
          && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
      }

      allow read: if isOwner(userId);
      allow create: if hasValidStrengthSession(userId, sessionId)
        && request.resource.data.state == 'in_progress'
        // Queued execution/lock batches must not launch a primary after replacement
        // supersedes it. Legacy execution ids may still refer to an absent occurrence.
        && (!('occurrenceId' in request.resource.data)
          || !existsAfter(/databases/$(database)/documents/users/$(userId)/session_occurrences/$(request.resource.data.occurrenceId))
          || getAfter(/databases/$(database)/documents/users/$(userId)/session_occurrences/$(request.resource.data.occurrenceId)).data.state != 'superseded');
      allow update: if hasValidStrengthSession(userId, sessionId)
        && keepsOwnership(userId)
        && resource.data.state == 'in_progress'
        && request.resource.data.date == resource.data.date
        && request.resource.data.startedAt == resource.data.startedAt;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/garmin_workout_queue/{date} {
      // Issue #1202 (ADR-0053): the status enum, the queuedAt/syncedAt/garminWorkoutId types
      // and the payload map type are owned by validateQueuedWorkoutWrite, which
      // GarminWorkoutQueueService.queueWorkout runs before every client write. Ownership, the
      // date-document binding, the key allow-lists and the size caps stay.
      function hasValidGarminQueuedWorkout(userId, date) {
        let data = request.resource.data;
        return hasOwnedUserId(userId)
          && isDateDocument(date)
          && data.keys().hasOnly(['userId', 'date', 'workoutTitle', 'modality', 'status', 'queuedAt', 'syncedAt', 'error', 'payload', 'garminWorkoutId'])
          && data.keys().hasAll(['userId', 'date', 'workoutTitle', 'modality', 'status', 'queuedAt', 'payload'])
          && data.workoutTitle is string && data.workoutTitle.size() <= 200
          && data.modality is string && data.modality.size() <= 64
          && (!('error' in data) || data.error == null || (data.error is string && data.error.size() <= 2000));
      }

      allow read: if isOwner(userId);
      allow create: if hasValidGarminQueuedWorkout(userId, date);
      allow update: if hasValidGarminQueuedWorkout(userId, date)
        && keepsOwnership(userId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/garmin_sync_requests/{requestId} {
      function hasValidGarminSyncRequest(userId) {
        let data = request.resource.data;
        return hasOwnedUserId(userId)
          && data.keys().hasOnly(['userId', 'status', 'requestedAt', 'completedAt', 'error', 'requestType', 'days', 'activityId'])
          && data.keys().hasAll(['userId', 'status', 'requestedAt'])
          && data.status == 'pending'
          && data.requestedAt is string
          && (!('requestType' in data) || data.requestType in ['sync', 'initial_backfill', 'backfill', 'activity_details'])
          && ((('requestType' in data) && data.requestType == 'activity_details')
            ? ('activityId' in data
              && data.activityId is string
              && data.activityId.trim().size() > 0
              && data.activityId.size() <= 128
              && !data.activityId.matches('.*/.*')
              && !(data.activityId in ['.', '..'])
              && exists(/databases/$(database)/documents/users/$(userId)/activities/$(data.activityId)))
            : !('activityId' in data))
          && (!('days' in data) || (isPositiveInt(data.days) && data.days <= 365))
          && (!('completedAt' in data) || data.completedAt == null)
          && (!('error' in data) || data.error == null);
      }

      allow read: if isOwner(userId);
      allow create, update: if hasValidGarminSyncRequest(userId) && requestId == 'latest';
      allow delete: if isOwner(userId);
    }

    // --- MS4/ADR-0027: server-owned integration connection metadata.
    match /users/{userId}/connections/{connectionId} {
      allow read: if isOwner(userId);
      // Server-managed only: client writes denied by default.
    }
