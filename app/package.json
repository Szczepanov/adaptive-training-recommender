{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate:workouts",
    "predev": "npm run check",
    "dev": "vite",
    "build": "npm run check && npm run build:bundle",
    "build:bundle": "vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate:workouts": "node --experimental-strip-types scripts/validate-workouts.ts",
    "simulate:scenarios": "node scripts/simulate-scenarios.mjs",
    "simulate:calibrate": "node scripts/simulate-calibrate.mjs",
    "simulate:plan-judge": "node scripts/simulate-plan-judge.mjs",
    "analyze:plan-judge": "node scripts/analyze-plan-judge.mjs",
    "judge:diff": "node scripts/check-plan-judge-drift.mjs",
    "simulate:fatigue-fusion": "node scripts/simulate-fatigue-fusion.mjs",
    "simulate:subjective-drift": "node scripts/simulate-subjective-drift.mjs",
    "evidence:health-anomaly": "node scripts/health-anomaly-evidence.mjs",
    "measure:garmin-zone-credit": "node scripts/measure-garmin-zone-credit.mjs",
    "simulate:diff": "node scripts/simulate-diff.mjs",
    "simulate:update-baseline": "node scripts/simulate-update-baseline.mjs",
    "compare:sequence-search": "node scripts/compare-sequence-search.mjs",
    "replay:recommendation": "node scripts/replay-recommendation-audit.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting --project adaptive-training-recommender",
    "deploy:hosting": "npm run build && firebase deploy --only hosting --project adaptive-training-recommender",
    "deploy:all": "npm run build && firebase deploy --project adaptive-training-recommender",
    "deploy:indexes": "firebase deploy --only firestore:indexes --project adaptive-training-recommender",
    "test": "vitest run",
    "test:rules": "firebase --project demo-adaptive-training emulators:exec --only firestore \"npm run test:rules:emulator\"",
    "test:rules:emulator": "vitest run src/emulator/*.emulator.test.ts",
    "firestore:rules:drift": "node scripts/check-firestore-rules-drift.mjs --project adaptive-training-recommender",
    "firestore:rules:deploy": "node scripts/deploy-firestore-rules.mjs --project adaptive-training-recommender",
    "firestore:rules:rollback": "node scripts/rollback-firestore-rules.mjs --project adaptive-training-recommender",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "visual:install": "playwright install chromium",
    "visual:serve": "vite --mode visual --host 127.0.0.1 --port 4174",
    "visual:refresh": "node scripts/prepare-visual-review.mjs && playwright test --project=visual-desktop --project=visual-mobile && node scripts/finalize-visual-review.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "firebase-tools": "^15.28.1",
    "globals": "^17.11.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.2": true,
    "protobufjs@7.6.5": true,
    "re2@1.26.1": true
  }
}
