# Env vars for the scheduled Cloud Run Jobs.
# Copy to cloud-run-job.env.yaml (gitignored), fill in the placeholders, and pass it to
# `gcloud run jobs create/update` via --env-vars-file=cloud-run-job.env.yaml.
# Do NOT commit the filled-in copy -- it's deploy-time config, not source.
#
# APP_USER_IDS is a comma-separated list of Firebase Authentication UIDs. The *-all CLI
# commands derive each user's token/archive paths automatically; do not set a shared
# GARMIN_TOKEN_OBJECT in multi-user mode.

APP_USER_IDS: "firebase_uid_one,firebase_uid_two"
APP_TIMEZONE: "Europe/Warsaw"
GARMIN_TOKEN_STORE: "gcs"
GARMIN_TOKEN_BUCKET: "your-garmin-private-bucket"
GARMIN_ALLOW_CREDENTIAL_LOGIN: "false"
GARMIN_ACTIVITY_DETAIL_ENABLED: "false"
GCP_PROJECT_ID: "your-gcp-project-id"
