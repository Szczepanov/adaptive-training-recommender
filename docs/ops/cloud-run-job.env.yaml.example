# Shared non-secret runtime config for Garmin account linking + scheduled Cloud Run Jobs.
# Active users are discovered from server-only garminConnections documents; do not set
# APP_USER_IDS or a shared GARMIN_TOKEN_OBJECT.

APP_TIMEZONE: "Europe/Warsaw"
GARMIN_TOKEN_STORE: "gcs"
GARMIN_TOKEN_BUCKET: "your-garmin-private-bucket"
GARMIN_ALLOW_CREDENTIAL_LOGIN: "false"
GARMIN_ACTIVITY_DETAIL_ENABLED: "false"
GCP_PROJECT_ID: "your-gcp-project-id"
