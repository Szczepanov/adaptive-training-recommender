# --- Required ---
# Firebase Authentication UID of the application user. Snapshots are written to
# users/{APP_USER_ID}/daily_recovery_snapshots/{date}. Must NOT be "default_user".
APP_USER_ID=your_firebase_uid_here

# --- Garmin credentials (used for full login when no cached tokens are available) ---
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_secure_password

# --- Timezone ---
# All calendar-date logic (sync target date, D-1 lookback) uses this timezone.
APP_TIMEZONE=Europe/Warsaw

# --- Garmin token persistence ---
# Path to local single JSON file used to cache Garmin OAuth tokens between runs.
GARMIN_TOKEN_PATH=.garmin_tokens/garmin_tokens.json
# "local" for local development, "gcs" for Cloud Run (persists token JSON in a private GCS bucket).
GARMIN_TOKEN_STORE=local
GCP_PROJECT_ID=your_gcp_project_id
GARMIN_TOKEN_BUCKET=your_private_token_bucket
GARMIN_TOKEN_OBJECT=garmin/garmin_tokens.json

# --- Firestore ---
FIRESTORE_RECOVERY_COLLECTION=daily_recovery_snapshots
# Path to a local Firebase service-account JSON. Leave unset in Cloud Run to use
# Application Default Credentials instead.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Host path mounted by docker-compose.yml. The long bind syntax intentionally fails if
# this file is missing instead of creating a directory at the source path.
FIREBASE_CREDENTIALS_HOST_PATH=./firebase-service-account.json

# --- Docker Compose local exposure ---
# Keep account-link services on loopback by default. Change only when LAN access is intended.
COMPOSE_BIND_ADDRESS=127.0.0.1

# --- Google Health OAuth account linking (optional for local smoke; required for real linking) ---
GOOGLE_HEALTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_HEALTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:8080/api/google-health/callback
GOOGLE_HEALTH_TOKEN_BUCKET=your_private_google_health_token_bucket
APP_BASE_URL=http://localhost:8080

# --- Garmin API resilience ---
GARMIN_RETRY_ATTEMPTS=3
GARMIN_RETRY_MIN_WAIT=1.0
GARMIN_RETRY_MAX_WAIT=10.0
GARMIN_VERIFY_LOGIN=true
GARMIN_ALLOW_CREDENTIAL_LOGIN=false
GARMIN_STALENESS_MINUTES=60
# After syncing the target date, `garmin_sync sync` also force-resyncs this many
# preceding day(s) -- picks up Garmin data that finalized/arrived after that day's own
# sync already ran, e.g. a training session logged later that day. Override per-run with
# `garmin_sync sync --resync-days N`.
GARMIN_RESYNC_LOOKBACK_DAYS=1

# --- Raw archive (optional, opt-in) ---
# Archives every raw Garmin JSON payload immutably (gzip-compressed) so snapshots can
# be recomputed offline via `garmin_sync rebuild` without re-calling Garmin, and audited
# via `garmin_sync audit`. Disabled by default -- nothing changes until you enable it.
GARMIN_ARCHIVE_ENABLED=false
# "local" for local development, "gcs" for Cloud Run.
GARMIN_ARCHIVE_STORE=gcs
# Falls back to GARMIN_TOKEN_BUCKET if unset -- the raw archive can share the same
# private bucket as the token store, under a different object prefix.
GARMIN_ARCHIVE_BUCKET=
GARMIN_ARCHIVE_PREFIX=raw/garmin
GARMIN_ARCHIVE_LOCAL_DIR=.garmin_archive

# --- Direct Eight Sleep ingestion (opt-in, default-off, ADR-0030) ---
# Owned read-only connector to Eight Sleep's private API. Nothing changes until you
# enable it. Not yet wired into any daily-sync CLI command -- currently exercised via
# the standalone probe: `uv run python -m garmin_sync.eight_sleep_probe --date YYYY-MM-DD`
# (prints a sanitized shape summary; never prints secrets or health values).
EIGHT_SLEEP_DIRECT_ENABLED=false
# Your Eight Sleep account credentials.
EIGHT_SLEEP_EMAIL=your_email@example.com
EIGHT_SLEEP_PASSWORD=your_secure_password
# OAuth password-grant client identifiers used by the official Eight Sleep app itself
# to authenticate against auth-api.8slp.net -- Eight Sleep has no public developer
# portal, so these are NOT generated per-account. Per D-8S-SECRETS (ADR-0030) this repo
# deliberately does not commit reverse-engineered client credentials; source the actual
# values yourself from a community reference (e.g. the archived `pyeight` project or
# Home Assistant's Eight Sleep integration, which vendor the same constants).
EIGHT_SLEEP_CLIENT_ID=
EIGHT_SLEEP_CLIENT_SECRET=
# Optional -- auto-discovered after authentication if left unset.
EIGHT_SLEEP_USER_ID=
EIGHT_SLEEP_TIMEZONE=Europe/Warsaw
EIGHT_SLEEP_TIMEOUT_SECONDS=20
EIGHT_SLEEP_MAX_RETRIES=2

# --- Frontend Firebase Web App Configuration (used by docker-compose build) ---
# Also present in app/.env.local for local Vite dev.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_HEALTH_ANOMALY_POLICY=off
VITE_TRAINING_OCCURRENCE_ACTIVITIES_POLICY=off
