# --- Required ---
# Firebase Authentication UID of the application user. Snapshots are written to
# users/{APP_USER_ID}/daily_recovery_snapshots/{date}. Must NOT be "default_user".
APP_USER_ID=your_firebase_uid_here

# --- Garmin credentials (used for full login when no cached tokens are available) ---
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_secure_password

# --- Timezone ---
# All calendar-date logic (sync target date, D-1 lookback) uses this timezone.
APP_TIMEZONE=Europe/Warsaw

# --- Garmin token persistence ---
# Path to local single JSON file used to cache Garmin OAuth tokens between runs.
GARMIN_TOKEN_PATH=.garmin_tokens/garmin_tokens.json
# "local" for local development, "gcs" for Cloud Run (persists token JSON in a private GCS bucket).
GARMIN_TOKEN_STORE=local
GCP_PROJECT_ID=your_gcp_project_id
GARMIN_TOKEN_BUCKET=your_private_token_bucket
GARMIN_TOKEN_OBJECT=garmin/garmin_tokens.json

# --- Firestore ---
FIRESTORE_RECOVERY_COLLECTION=daily_recovery_snapshots
# Path to a local Firebase service-account JSON. Leave unset in Cloud Run to use
# Application Default Credentials instead.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# --- Garmin API resilience ---
GARMIN_RETRY_ATTEMPTS=3
GARMIN_RETRY_MIN_WAIT=1.0
GARMIN_RETRY_MAX_WAIT=10.0
GARMIN_VERIFY_LOGIN=true
GARMIN_ALLOW_CREDENTIAL_LOGIN=false
GARMIN_STALENESS_MINUTES=60
